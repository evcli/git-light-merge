#compdef git-lm git-light-merge

# Zsh completion script for git-light-merge
# Supports 'git lm <TAB>' and 'git-light-merge <TAB>'

_git-lm() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1: :->command' \
    '*: :->args'

  case $state in
    command)
      local -a commands
      commands=(
        'add:Add a feature and re-merge'
        'rm:Remove a feature and re-merge'
        'status:Show current status'
        'list:List all light-merge tasks'
        'ls:List all light-merge tasks'
        'continue:Continue after resolving conflicts'
        'abort:Stop and delete current session'
        'rebase:Update base and rebuild'
        'refresh:Update base/features and rebuild'
        'push:Push to remote'
        'pick:Interactively pick features'
        'clear:Delete ALL light-merge tasks'
        'prune:Cleanup old state files'
        'help:Show help'
      )
      _describe -t commands 'command' commands
      ;;
    args)
      case $line[1] in
        add|rm|pick)
          # Use internal git completion helper if available, otherwise fallback to simple branch list
          if (( $+functions[_git_branches] )); then
            _git_branches
          else
            _values 'branches' $(git branch --format='%(refname:short)')
          fi
          ;;
        *)
          _message "no more arguments"
          ;;
      esac
      ;;
  esac
}

# This handles both 'git lm' and 'git-light-merge'
if [[ "$words[1]" == "git" ]]; then
    _git-lm "$@"
else
    _git-lm "$@"
fi
