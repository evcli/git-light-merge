#!/usr/bin/env bash

set -euo pipefail

# git-light-merge (git lm)
# 
# A tool to automate merging multiple branches into a single light-merge branch.
# The result is a single squash commit on the light-merge branch.
#
# Requires modern Bash (Bash 5.0+). Optimized for Bash 5.x syntax and performance.

LM_USER="${GIT_LM_USER:-${USER:-${USERNAME:-unknown}}}"
LM_NAME_TEMPLATE="${GIT_LM_TEMPLATE:-"light-merge/{user}-{name}"}"
LM_PREFIX="${LM_NAME_TEMPLATE%%\{*}" 
LM_GIT_DIR=""
LM_STATE_ROOT=""
GIT_LM_PICKER_PLUGIN="${GIT_LM_PICKER_PLUGIN:-}"

ensure_picker_plugin() {
    if [[ -z "$GIT_LM_PICKER_PLUGIN" ]]; then
        local script_dir="${BASH_SOURCE[0]%/*}"
        if [[ "$script_dir" == "${BASH_SOURCE[0]}" ]]; then
            script_dir="."
        fi
        script_dir=$(cd "$script_dir" && pwd)
        GIT_LM_PICKER_PLUGIN="$script_dir/git-lm-picker"
    fi
}

# Color output functions
log_info() { printf "\e[32m%b\e[0m\n" "$*" >&2; }
log_warn() { printf "\e[33m%b\e[0m\n" "$*" >&2; }
log_err()  { printf "\e[31m%b\e[0m\n" "$*" >&2; }

show_help() {
    cat <<EOF
Usage: git lm [command] [options]

Commands:
  git lm create|new|mk <name> <features...>    Create and merge light-merge branch
  git lm pick [name] [--base branch]           Interactively pick features
  git lm add [feature] [name]                  Add feature to task ('.' for current branch)
  git lm rm [feature] [name]                   Remove feature from task ('.' for current)
  git lm status|st [name]                      Show status (auto-selects if unique)
  git lm refresh|rf [name] [--base branch]     Update base/features and rebuild task
  git lm list|ls                               List all light-merge tasks
  git lm push [name]                           Push to remote
  git lm continue|con                          Continue after resolving conflicts
  git lm abort [name]                          Stop and delete a task
  git lm clear                                 Delete ALL light-merge tasks
  git lm prune                                 Cleanup old state files

Options:
  --base <branch>   Specify base branch
EOF
}

ensure_git_repo() {
    LM_GIT_DIR=$(git rev-parse --git-dir 2>/dev/null) || {
        log_err "Error: Not a git repository"
        exit 1
    }
    LM_STATE_ROOT="$LM_GIT_DIR/light-merge"
}

resolve_ref() {
    local name="$1"
    # 1. Try resolving as is (local branch, tag, etc.)
    if git rev-parse --verify "$name" >/dev/null 2>&1; then
        echo "$name"
        return 0
    fi
    # 2. Try origin prefix
    if git rev-parse --verify "origin/$name" >/dev/null 2>&1; then
        echo "origin/$name"
        return 0
    fi
    # 3. Try fetching on-demand
    log_info "Ref $name not found, trying to fetch from origin..."
    if git fetch origin "$name" >/dev/null 2>&1; then
        echo "FETCH_HEAD"
        return 0
    fi
    return 1
}

get_current_branch() {
    git branch --show-current
}

is_lm_branch() {
    local branch=$(get_current_branch)
    [[ -n "$branch" && "$branch" == "$LM_PREFIX"* ]]
}

get_lm_name() {
    get_current_branch
}

get_state_dir() {
    local var_name=$1
    local full_name=$2
    # Replace chars that are problematic in paths across OSes
    local safe_name="${full_name//[\/\\ :*?\"<>|]/__}"
    printf -v "$var_name" "%s" "$LM_STATE_ROOT/$safe_name"
}

resolve_lm_branch() {
    local var_name=$1
    local name=$2
    local target="${LM_NAME_TEMPLATE//\{user\}/$LM_USER}"
    target="${target//\{name\}/$name}"
    printf -v "$var_name" "%s" "$target"
}

# Helper to find the target LM branch when not on one
find_target_lm() {
    local input_name="${1:-}"
    LM_RESOLVED_BRANCH=""
    
    if [[ -n "$input_name" ]]; then
        resolve_lm_branch LM_RESOLVED_BRANCH "$input_name"
        return 0
    fi
    
    local current_branch
    current_branch=$(git branch --show-current 2>/dev/null || echo "")
    if [[ -n "$current_branch" && "$current_branch" == "$LM_PREFIX"* ]]; then
        LM_RESOLVED_BRANCH="$current_branch"
        return 0
    fi
    
    local branches=($(git branch --list "${LM_PREFIX}*" --format='%(refname:short)'))
    if [[ ${#branches[@]} -eq 1 ]]; then
        log_info "Auto-selecting task: ${branches[0]}"
        LM_RESOLVED_BRANCH="${branches[0]}"
        return 0
    elif [[ ${#branches[@]} -gt 1 ]]; then
        # Dynamically let the user pick one task interactively!
        local task_list=""
        for b in "${branches[@]}"; do
            local n="${b#$LM_PREFIX}"
            local clean_name="${n#$LM_USER-}"
            task_list="$task_list$clean_name"$'\n'
        done
        
        local choice=""
        local exit_code=0
        ensure_picker_plugin
        if [[ -x "$GIT_LM_PICKER_PLUGIN" ]]; then
            choice=$(printf "%s" "$task_list" | "$GIT_LM_PICKER_PLUGIN" --header "Select light-merge task:" --single)
            exit_code=$?
        fi
        
        if [[ $exit_code -ne 0 ]]; then
            log_warn "Aborted."
            return 1
        fi
        
        if [[ -n "$choice" ]]; then
            resolve_lm_branch LM_RESOLVED_BRANCH "$choice"
            return 0
        else
            log_err "Error: No task selected."
            return 1
        fi
    else
        log_err "Error: No light-merge tasks found."
        return 1
    fi
}

save_state() {
    local name=$1
    local base=$2
    local features_content="$3"
    local pending_content="$4"
    local state_dir
    get_state_dir state_dir "$name"
    
    mkdir -p "$state_dir"
    echo "$base" > "$state_dir/base"
    printf "%s" "$features_content" > "$state_dir/features"
    printf "%s" "$pending_content" > "$state_dir/pending"
}

load_state() {
    local name=$1
    local state_dir
    get_state_dir state_dir "$name"
    
    if [[ ! -d "$state_dir" ]]; then
        return 1
    fi
    
    LM_BASE=$(cat "$state_dir/base")
    # Read line by line safely
    LM_FEATURES=()
    while read -r line || [[ -n "$line" ]]; do [[ -n "$line" ]] && LM_FEATURES+=("$line"); done < "$state_dir/features"
    
    LM_PENDING=()
    if [[ -f "$state_dir/pending" ]]; then
        while read -r line || [[ -n "$line" ]]; do [[ -n "$line" ]] && LM_PENDING+=("$line"); done < "$state_dir/pending"
    fi
    return 0
}

# Core merge logic
do_merge() {
    local name=$1
    local base=$2
    shift 2
    local features=("$@")
    
    local target_branch="${LM_NAME_TEMPLATE//\{user\}/$LM_USER}"
    target_branch="${target_branch//\{name\}/$name}"
    
    if [[ -n "$(git status --porcelain)" ]]; then
        log_err "Error: Working tree is not clean."
        exit 1
    fi

    # Pre-flight check
    for f in "${features[@]}"; do
        if ! resolve_ref "$f" >/dev/null; then
            log_err "Error: Could not resolve $f. Aborting."
            exit 1
        fi
    done

    local base_ref=$(resolve_ref "$base") || { log_err "Error: Base $base not found"; exit 1; }
    
    git checkout -q -B "$target_branch" "$base_ref"
    
    LM_FEATURES=("${features[@]}")
    run_merge_loop "$target_branch" "$base" "${features[@]}"
}

run_merge_loop() {
    local target_branch=$1
    local base=$2
    shift 2
    local queue=("$@")
    local total=${#queue[@]}
    local i=0

    for feature in "${queue[@]}"; do
        i=$((i + 1))
        log_info "[$i/$total] -> Merging: $feature..."
        
        local ref=$(resolve_ref "$feature")
        
        if ! git merge -q --no-ff --no-commit "$ref" -m "Temp merge $feature" >/dev/null 2>&1; then
            log_err "!!! Conflict detected in $feature !!!"
            local remaining=("${queue[@]:$((i-1))}")
            local feat_content=$(printf "%s\n" "${LM_FEATURES[@]}")
            local pend_content=$(printf "%s\n" "${remaining[@]}")
            save_state "$target_branch" "$base" "$feat_content" "$pend_content"
            log_warn "Manual steps:"
            log_info "  1. Resolve conflicts"
            log_info "  2. git add . && git commit"
            log_info "  3. git lm continue"
            exit 1
        fi
        
        if ! git diff --cached --quiet; then
            git commit -q --no-edit >/dev/null 2>&1
        fi
    done

    # Finalize
    log_info "Finalizing squash merge..."
    git reset -q --soft "$(resolve_ref "$base")" >/dev/null 2>&1
    
    local msg_list=""
    for f in "${LM_FEATURES[@]}"; do msg_list="$msg_list\n- $f"; done
    printf "Integrated: $target_branch\n\nIncluded features:$msg_list" | git commit -q --allow-empty -F - >/dev/null 2>&1
    
    local feat_content=$(printf "%s\n" "${LM_FEATURES[@]}")
    save_state "$target_branch" "$base" "$feat_content" ""
    printf "\e[90m========================================\e[0m\n" >&2
    printf "\e[1;32mSuccess!\e[0m\n" >&2
    printf "\e[1;36mTarget:   \e[1;33m%s\e[0m\n" "$target_branch" >&2
    printf "\e[1;36mBase:     \e[0m%s\n" "$base" >&2
    printf "\e[1;36mFeatures:\e[0m\n" >&2
    for f in "${LM_FEATURES[@]}"; do
        printf "  \e[32m-\e[0m %s\n" "$f" >&2
    done
    printf "\e[90m========================================\e[0m\n" >&2
}

continue_cmd() {
    local target_branch=$(get_current_branch)
    if [[ -z "$target_branch" || "$target_branch" != "$LM_PREFIX"* ]]; then
        log_err "Error: Not on a LM branch"
        exit 1
    fi
    load_state "$target_branch" || { log_err "Error: No state found"; exit 1; }
    
    if [[ ${#LM_PENDING[@]} -eq 0 ]]; then
        log_info "Nothing to continue."
        exit 0
    fi

    if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
        log_err "Error: Merge in progress. Please resolve conflicts and commit first."
        exit 1
    fi

    log_info "Resuming merge loop for: ${LM_PENDING[*]}"
    run_merge_loop "$target_branch" "$LM_BASE" "${LM_PENDING[@]}"
}

status_cmd() {
    find_target_lm "${1:-}" || return 1

    local full_name="$LM_RESOLVED_BRANCH"

    if load_state "$full_name"; then
        echo "Branch  : $full_name"
        echo "Base    : $LM_BASE"
        echo "Features: ${LM_FEATURES[*]}"
        [[ ${#LM_PENDING[@]} -gt 0 ]] && log_warn "Pending : ${LM_PENDING[*]}"
    else
        log_err "Error: No state found for $full_name"
    fi
}

abort_cmd() {
    find_target_lm "${1:-}" || return 1
    local target_branch="$LM_RESOLVED_BRANCH"
    load_state "$target_branch" && {
        git checkout "$LM_BASE"
        git branch -D "$target_branch"
        local state_dir
        get_state_dir state_dir "$target_branch"
        rm -rf "$state_dir"
        log_info "Aborted and cleaned up $target_branch."
    }
}

prune_cmd() {
    log_info "Pruning orphaned state files..."
    local count=0
    if [[ -d "$LM_STATE_ROOT" ]]; then
        for d in "$LM_STATE_ROOT"/*; do
            [[ -d "$d" ]] || continue
            local safe_name=$(basename "$d")
            # Restore the name (though approximate since multiple names can map to same safe name)
            # Actually, the best way is to check if any branch matches the directory name pattern
            local found=0
            local branches=($(git branch --list --format='%(refname:short)'))
            for b in "${branches[@]}"; do
                local s="${b//[\/\\ :*?\"<>|]/__}"
                if [[ "$s" == "$safe_name" ]]; then
                    found=1; break
                fi
            done
            
            if [[ $found -eq 0 ]]; then
                rm -rf "$d"
                count=$((count + 1))
            fi
        done
    fi
    find "$LM_STATE_ROOT" -type d -empty -delete 2>/dev/null || true
    log_info "Cleaned up $count orphaned tasks."
}

push_cmd() {
    local target_branch=$(get_current_branch)
    log_info "Pushing to origin..."
    git push origin "$target_branch"
}

pick_cmd() {
    local base="$1"; shift
    local name=""
    if [[ $# -lt 1 ]]; then
        # Check if there are no existing light-merge tasks
        local branches=($(git branch --list "${LM_PREFIX}*" --format='%(refname:short)'))
        if [[ ${#branches[@]} -eq 0 ]]; then
            log_err "Error: No existing light-merge tasks. To create a new one, please specify a name:"
            log_err "Usage: git lm pick [--base branch] <name>"
            exit 1
        fi
        
        # Now call find_target_lm safely without any redirection so the TUI renders perfectly!
        if ! find_target_lm ""; then
            exit 1
        fi
        local resolved_branch="$LM_RESOLVED_BRANCH"
        
        # Extract the clean name from the resolved full branch name (e.g. light-merge/evan-test -> test)
        local suffix="${resolved_branch#$LM_PREFIX}"
        local user_prefix="${LM_NAME_TEMPLATE#$LM_PREFIX}"
        user_prefix="${user_prefix%%\{name\}*}"
        user_prefix="${user_prefix//\{user\}/$LM_USER}"
        name="${suffix#$user_prefix}"
    else
        name=$1
    fi
    
    local selected_features=()
    local LM_FEATURES=()

    # Resolve base branch first
    if [[ -z "$base" ]]; then
        # Try to load existing state to reuse the base branch
        local full_name
        resolve_lm_branch full_name "$name"
        if load_state "$full_name" >/dev/null 2>&1; then
            base="$LM_BASE"
            log_info "Reusing existing base: $base"
        else
            # Try to read local cache first
            if [[ -f "$LM_STATE_ROOT/.default_branch" ]]; then
                base=$(cat "$LM_STATE_ROOT/.default_branch" 2>/dev/null)
            fi
            
            # Fall back to 1-subprocess fast auto-detection if no cache
            if [[ -z "$base" ]]; then
                local ref
                ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null || echo "")
                local default_branch="${ref#refs/remotes/origin/}"
                base="${default_branch:-main}"
                
                # Write resolved default branch to cache
                mkdir -p "$LM_STATE_ROOT"
                printf "%s" "$base" > "$LM_STATE_ROOT/.default_branch" 2>/dev/null || true
            fi
        fi
    else
        # Update cache whenever --base is explicitly passed
        mkdir -p "$LM_STATE_ROOT"
        printf "%s" "$base" > "$LM_STATE_ROOT/.default_branch" 2>/dev/null || true
    fi

    # Get branches sorted by committerdate, with local/remote categorization and base excluded
    local branch_list=$(git branch -a --sort=-committerdate --format='%(refname) %(refname:short)' | awk -v base="$base" -v prefix="$LM_PREFIX" '
        $1 ~ /\/HEAD$/ { next }
        $1 ~ /^refs\/heads\// {
            branch = $2
            if (branch == base) next
            if (index(branch, prefix) == 1) next
            is_local[branch] = 1
            if (!seen[branch]) {
                seen[branch] = 1
                order[++count] = branch
            }
        }
        $1 ~ /^refs\/remotes\// {
            idx = index($2, "/")
            if (idx > 0) {
                branch = substr($2, idx + 1)
                if (branch == base) next
                if (index(branch, prefix) == 1) next
                if (branch != "" && branch != "HEAD") {
                    is_remote[branch] = 1
                    if (!seen[branch]) {
                        seen[branch] = 1
                        order[++count] = branch
                    }
                }
            }
        }
        END {
            for (i = 1; i <= count; i++) {
                b = order[i]
                if (is_local[b] && is_remote[b]) {
                    print b " [local & remote]"
                } else if (is_local[b]) {
                    print b " [local only]"
                } else if (is_remote[b]) {
                    print b " [remote only]"
                }
            }
        }
    ')

    ensure_picker_plugin
    if [[ -x "$GIT_LM_PICKER_PLUGIN" ]]; then
        log_info "Using interactive Bash picker plugin..."
        local selected
        local existing_features=""
        if [[ ${#LM_FEATURES[@]} -gt 0 ]]; then
            # Join array elements by comma safely under set -u
            existing_features=$(IFS=,; echo "${LM_FEATURES[*]}")
        fi
        if ! selected=$(echo "$branch_list" | "$GIT_LM_PICKER_PLUGIN" --header "Base branch: $base | Select branches (Space/Tab to select, Enter to confirm)" --selected "$existing_features"); then
            log_warn "Aborted."
            exit 0
        fi
        
        while read -r line; do
            if [[ -n "$line" ]]; then
                selected_features+=("${line%% *}")
            fi
        done <<< "$selected"
    else
        log_info "Using native numbered list picker..."
        local annotated_branches=()
        while read -r line; do
            [[ -n "$line" ]] && annotated_branches+=("$line")
        done <<< "$branch_list"

        local limit=30
        local total=${#annotated_branches[@]}
        local count=$total
        if [[ $count -gt $limit ]]; then
            count=$limit
        fi

        log_info "Base branch: $base"
        for ((i=0; i<count; i++)); do
            printf "  [%2d] %s\n" "$((i+1))" "${annotated_branches[$i]}"
        done

        if [[ $total -gt $limit ]]; then
            log_warn "  ... showing first $limit of $total branches (sorted by recency)."
            log_info "  Tip: Configure 'git-lm-picker' plugin for a fully searchable interactive picker."
        fi

        printf "\nEnter branch numbers to merge (e.g., 1 3 5), or 'q' to quit: "
        read -r input
        if [[ "$input" == "q" ]]; then exit 0; fi
        for idx in $input; do
            if [[ "$idx" -gt 0 && "$idx" -le "$count" ]]; then
                local selected_annotated="${annotated_branches[$((idx-1))]}"
                selected_features+=("${selected_annotated%% *}")
            fi
        done
    fi

    if [[ ${#selected_features[@]} -eq 0 ]]; then
        log_warn "No features selected. Aborting."
        exit 0
    fi

    log_info "Selected features: ${selected_features[*]}"
    do_merge "$name" "$base" "${selected_features[@]}"
}

refresh_cmd() {
    local base=""
    local args=()
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "--base" ]]; then
            base="$2"; shift 2
        else
            args+=("$1"); shift
        fi
    done

    find_target_lm "${args[0]:-}" || return 1
    local full_name="$LM_RESOLVED_BRANCH"
    load_state "$full_name" || { log_err "Error: No state found for $full_name"; exit 1; }
    
    if [[ -n "$base" ]]; then
        LM_BASE="$base"
        # Update cache whenever --base is explicitly passed
        mkdir -p "$LM_STATE_ROOT"
        printf "%s" "$base" > "$LM_STATE_ROOT/.default_branch" 2>/dev/null || true
    fi
    
    local has_origin=0
    if git config --get remote.origin.url >/dev/null 2>&1; then
        has_origin=1
        log_info "Refreshing base and features for $full_name from origin..."
        # Update base (local branch)
        git fetch origin "$LM_BASE:$LM_BASE" 2>/dev/null || true
    else
        log_warn "No remote 'origin' found. Using local branches only."
    fi
    
    # Update features in a single batch fetch for performance
    local fetch_args=()
    for f in "${LM_FEATURES[@]}"; do
        if [[ $has_origin -eq 1 ]]; then
            fetch_args+=("$f:$f")
        fi
    done
    
    if [[ ${#fetch_args[@]} -gt 0 ]]; then
        log_info "Batch fetching features from origin..."
        git fetch origin "${fetch_args[@]}" 2>/dev/null || true
    fi
    
    local name="${full_name#$LM_PREFIX}"; name="${name#$LM_USER-}"
    do_merge "$name" "$LM_BASE" "${LM_FEATURES[@]}"
}

clear_cmd() {
    local branches=$(git branch --list "${LM_PREFIX}*" --format='%(refname:short)')
    if [[ -z "$branches" && ! -d "$LM_STATE_ROOT" ]]; then
        log_info "No light-merge tasks found."
        return
    fi

    log_warn "This will delete ALL local branches starting with '$LM_PREFIX' and the state directory '$LM_STATE_ROOT'."
    printf "Are you sure? [y/N] "
    read -r opt
    if [[ "$opt" != "y" && "$opt" != "Y" ]]; then
        log_info "Aborted."
        return
    fi
    
    if [[ -n "$branches" ]]; then
        local current=$(get_current_branch)
        if [[ "$current" == "$LM_PREFIX"* ]]; then
              local ref
              ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null || echo "")
              local default="${ref#refs/remotes/origin/}"
              default="${default:-master}"
              log_info "Switching to $default..."
              git checkout "$default" 2>/dev/null || git checkout main 2>/dev/null || git checkout master 2>/dev/null
        fi
        echo "$branches" | xargs git branch -D
    fi
    
    rm -rf "$LM_STATE_ROOT"
    log_info "All light-merge tasks cleared."
}

create_cmd() {
    local base=""
    local args=()
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "--base" ]]; then
            base="$2"; shift 2
        else
            args+=("$1"); shift
        fi
    done

    if [[ ${#args[@]} -lt 1 ]]; then show_help; exit 1; fi
    local name="${args[0]}"
    local features=()
    if [[ ${#args[@]} -gt 1 ]]; then
        for ((i=1; i<${#args[@]}; i++)); do
            features+=("${args[$i]}")
        done
    fi

    if [[ -z "$base" ]]; then
        # Try to load existing state to reuse the base branch
        local full_name
        resolve_lm_branch full_name "$name"
        if load_state "$full_name" >/dev/null 2>&1; then
            base="$LM_BASE"
            log_info "Reusing existing base: $base"
        else
            # Try to read local cache first
            if [[ -f "$LM_STATE_ROOT/.default_branch" ]]; then
                base=$(cat "$LM_STATE_ROOT/.default_branch" 2>/dev/null)
            fi
            
            # Fall back to 1-subprocess fast auto-detection if no cache
            if [[ -z "$base" ]]; then
                local ref
                ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null || echo "")
                local default_branch="${ref#refs/remotes/origin/}"
                base="${default_branch:-main}"
                
                # Write resolved default branch to cache
                mkdir -p "$LM_STATE_ROOT"
                printf "%s" "$base" > "$LM_STATE_ROOT/.default_branch" 2>/dev/null || true
            fi
        fi
    else
        # Update cache whenever --base is explicitly passed
        mkdir -p "$LM_STATE_ROOT"
        printf "%s" "$base" > "$LM_STATE_ROOT/.default_branch" 2>/dev/null || true
    fi
    
    if [[ ${#features[@]} -eq 0 && "$name" != "--help" && "$name" != "-h" ]]; then
        # If only name is provided, it might be an attempt to use 'git lm <name>' 
        # but the user didn't provide features. However, do_merge requires features.
        show_help
        exit 1
    fi

    do_merge "$name" "$base" "${features[@]}"
}

list_cmd() {
    local branches=$(git branch --list "${LM_PREFIX}*" --format='%(refname:short)')
    if [[ -z "$branches" ]]; then
        log_info "No light-merge branches found."
        return
    fi
    
    log_info "Available light-merge branches:"
    local current=$(get_current_branch)
    while read -r b; do
        local prefix="  "
        [[ "$b" == "$current" ]] && prefix="* "
        
        # Try to load state to show features
        if load_state "$b" >/dev/null 2>&1; then
            # Color the branch name if it's current
            if [[ "$b" == "$current" ]]; then
                printf "\e[32m%s%-30s\e[0m [%s] (%s)\n" "$prefix" "$b" "$LM_BASE" "${LM_FEATURES[*]}"
            else
                printf "%s%-30s [%s] (%s)\n" "$prefix" "$b" "$LM_BASE" "${LM_FEATURES[*]}"
            fi
        else
            printf "%s%-30s\n" "$prefix" "$b"
        fi
    done <<< "$branches"
}

add_cmd() {
    local feature="${1:-}"
    local target_task="${2:-}"
    
    # 1. Resolve feature: default to current branch if not provided or if '.' is used
    if [[ -z "$feature" || "$feature" == "." ]]; then
        feature=$(get_current_branch)
        if [[ -z "$feature" ]]; then log_err "Error: Not on a branch."; return 1; fi
        if [[ "$feature" == "$LM_PREFIX"* ]]; then
            log_err "Error: Cannot add a light-merge branch to itself."
            return 1
        fi
    fi
    
    # 2. Resolve target task
    find_target_lm "$target_task" || return 1
    local full_name="$LM_RESOLVED_BRANCH"
    
    # 3. Load state and check if already exists
    load_state "$full_name" || { log_err "Error: No state found for $full_name"; return 1; }

    if [[ "$feature" == "$LM_BASE" ]]; then
        log_err "Error: '$feature' is the base branch of $full_name. Cannot add base as a feature."
        return 1
    fi

    for f in "${LM_FEATURES[@]}"; do
        if [[ "$f" == "$feature" ]]; then
            log_info "Feature $feature is already in $full_name. Refreshing..."
            local name="${full_name#$LM_PREFIX}"; name="${name#$LM_USER-}"
            do_merge "$name" "$LM_BASE" "${LM_FEATURES[@]}"
            return
        fi
    done
    
    # 4. Add and rebuild
    LM_FEATURES+=("$feature")
    local name="${full_name#$LM_PREFIX}"; name="${name#$LM_USER-}"
    log_info "Adding $feature to $full_name..."
    do_merge "$name" "$LM_BASE" "${LM_FEATURES[@]}"
}

rm_cmd() {
    local feature="${1:-}"
    local target_task="${2:-}"
    
    # 1. Resolve feature: default to current branch if not provided or if '.' is used
    if [[ -z "$feature" || "$feature" == "." ]]; then
        feature=$(get_current_branch)
    fi
    
    # 2. Resolve target task
    find_target_lm "$target_task" || return 1
    local full_name="$LM_RESOLVED_BRANCH"
    
    # 3. Load state and filter
    load_state "$full_name" || { log_err "Error: No state found for $full_name"; return 1; }

    if [[ "$feature" == "$LM_BASE" ]]; then
        log_err "Error: '$feature' is the base branch of $full_name. To change the base, use 'git lm rebase --base <new_base>'."
        return 1
    fi

    local new_features=()
    local found=0
    for f in "${LM_FEATURES[@]}"; do
        if [[ "$f" == "$feature" ]]; then
            found=1
        else
            new_features+=("$f")
        fi
    done
    
    if [[ $found -eq 0 ]]; then
        log_warn "Feature $feature not found in $full_name."
        return
    fi
    
    # 4. Rebuild
    local name="${full_name#$LM_PREFIX}"; name="${name#$LM_USER-}"
    log_info "Removing $feature from $full_name..."
    do_merge "$name" "$LM_BASE" "${new_features[@]}"
}

main() {
    ensure_git_repo
    [[ $# -eq 0 ]] && { show_help; exit 0; }

    case "$1" in
        create|new|mk) shift; create_cmd "$@" ;;
        add) shift; add_cmd "$@" ;;
        rm)  shift; rm_cmd "$@" ;;
        status|st) shift; status_cmd "$@" ;;
        list|ls) list_cmd ;;
        abort)
            shift
            local target_task="${1:-}"
            abort_cmd "$target_task"
            ;;
        continue|con) continue_cmd ;;
        push)
            find_target_lm "${2:-}" || exit 1
            local b="$LM_RESOLVED_BRANCH"
            log_info "Pushing $b to origin..."
            git push origin --delete "$b" 2>/dev/null || true
            git checkout "$b" 2>/dev/null
            push_cmd
            ;;
        refresh|rebase|rf) shift; refresh_cmd "$@" ;;
        clear)   clear_cmd ;;
        pick)
            shift
            local base=""
            local args=()
            while [[ $# -gt 0 ]]; do
                if [[ "$1" == "--base" ]]; then
                    base="$2"; shift 2
                else
                    args+=("$1"); shift
                fi
            done
            pick_cmd "$base" "${args[@]}"
            ;;
        prune) prune_cmd ;;
        help|--help|-h) show_help ;;
        *) create_cmd "$@" ;;
    esac
}

main "$@"
