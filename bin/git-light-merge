#!/usr/bin/env bash

set -euo pipefail

# git-light-merge (git lm)
# 
# A tool to automate merging multiple branches into a single light-merge branch.
# The result is a single squash commit on the light-merge branch.

LM_USER="${GIT_LM_USER:-$(whoami)}"
LM_NAME_TEMPLATE="${GIT_LM_TEMPLATE:-"light-merge/{user}-{name}"}"
LM_PREFIX="${LM_NAME_TEMPLATE%%\{*}" 
LM_GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || echo ".git")
LM_STATE_ROOT="$LM_GIT_DIR/light-merge"

# Color output functions
log_info() { printf "\e[32m%b\e[0m\n" "$*" >&2; }
log_warn() { printf "\e[33m%b\e[0m\n" "$*" >&2; }
log_err()  { printf "\e[31m%b\e[0m\n" "$*" >&2; }

show_help() {
    cat <<EOF
Usage: git lm [command] [options]

Commands:
  git lm create|new|mk <name> <features...>    Create and merge light-merge branch
  git lm pick [name] [--base branch]           Interactively pick features
  git lm add [feature] [name]                  Add feature to task ('.' for current branch)
  git lm rm [feature] [name]                   Remove feature from task ('.' for current)
  git lm status|st [name]                      Show status (auto-selects if unique)
  git lm refresh|rf [name] [--base branch]     Update base/features and rebuild task
  git lm list|ls                               List all light-merge tasks
  git lm push [name]                           Push to remote
  git lm continue|con                          Continue after resolving conflicts
  git lm abort [name]                          Stop and delete a task
  git lm clear                                 Delete ALL light-merge tasks
  git lm prune                                 Cleanup old state files

Options:
  --base <branch>   Specify base branch
EOF
}

ensure_git_repo() {
    git rev-parse --git-dir >/dev/null 2>&1 || {
        log_err "Error: Not a git repository"
        exit 1
    }
}

resolve_ref() {
    local name="$1"
    # 1. Try resolving as is (local branch, tag, etc.)
    if git rev-parse --verify "$name" >/dev/null 2>&1; then
        echo "$name"
        return 0
    fi
    # 2. Try origin prefix
    if git rev-parse --verify "origin/$name" >/dev/null 2>&1; then
        echo "origin/$name"
        return 0
    fi
    # 3. Try fetching on-demand
    log_info "Ref $name not found, trying to fetch from origin..."
    if git fetch origin "$name" >/dev/null 2>&1; then
        echo "FETCH_HEAD"
        return 0
    fi
    return 1
}

get_current_branch() {
    git branch --show-current
}

is_lm_branch() {
    local branch=$(get_current_branch)
    [[ -n "$branch" && "$branch" == "$LM_PREFIX"* ]]
}

get_lm_name() {
    get_current_branch
}

get_state_dir() {
    local full_name=$1
    # Replace chars that are problematic in paths across OSes
    local safe_name="${full_name//[\/\\ :*?\"<>|]/__}"
    echo "$LM_STATE_ROOT/$safe_name"
}

resolve_lm_branch() {
    local name=$1
    local target="${LM_NAME_TEMPLATE//\{user\}/$LM_USER}"
    target="${target//\{name\}/$name}"
    echo "$target"
}

# Helper to find the target LM branch when not on one
find_target_lm() {
    local input_name="${1:-}"
    if [[ -n "$input_name" ]]; then
        resolve_lm_branch "$input_name"
        return 0
    fi
    
    if is_lm_branch; then
        get_current_branch
        return 0
    fi
    
    local branches=($(git branch --list "${LM_PREFIX}*" --format='%(refname:short)'))
    if [[ ${#branches[@]} -eq 1 ]]; then
        log_info "Auto-selecting task: ${branches[0]}"
        echo "${branches[0]}"
        return 0
    elif [[ ${#branches[@]} -gt 1 ]]; then
        log_err "Error: Multiple tasks found. Please specify one:"
        for b in "${branches[@]}"; do
            local n="${b#$LM_PREFIX}"
            printf "  - %s\n" "${n#$LM_USER-}" >&2
        done
        return 1
    else
        log_err "Error: No light-merge tasks found."
        return 1
    fi
}

save_state() {
    local name=$1
    local base=$2
    local features_content="$3"
    local pending_content="$4"
    local state_dir=$(get_state_dir "$name")
    
    mkdir -p "$state_dir"
    echo "$base" > "$state_dir/base"
    printf "%s" "$features_content" > "$state_dir/features"
    printf "%s" "$pending_content" > "$state_dir/pending"
}

load_state() {
    local name=$1
    local state_dir=$(get_state_dir "$name")
    
    if [[ ! -d "$state_dir" ]]; then
        return 1
    fi
    
    LM_BASE=$(cat "$state_dir/base")
    # Read line by line safely
    LM_FEATURES=()
    while read -r line || [[ -n "$line" ]]; do [[ -n "$line" ]] && LM_FEATURES+=("$line"); done < "$state_dir/features"
    
    LM_PENDING=()
    if [[ -f "$state_dir/pending" ]]; then
        while read -r line || [[ -n "$line" ]]; do [[ -n "$line" ]] && LM_PENDING+=("$line"); done < "$state_dir/pending"
    fi
    return 0
}

# Core merge logic
do_merge() {
    local name=$1
    local base=$2
    shift 2
    local features=("$@")
    
    local target_branch="${LM_NAME_TEMPLATE//\{user\}/$LM_USER}"
    target_branch="${target_branch//\{name\}/$name}"
    
    if [[ -n "$(git status --porcelain)" ]]; then
        log_err "Error: Working tree is not clean."
        exit 1
    fi

    # Pre-flight check
    log_info "Pre-flight check: Resolving all feature branches..."
    for f in ${features[@]+"${features[@]}"}; do
        if ! resolve_ref "$f" >/dev/null; then
            log_err "Error: Could not resolve $f. Aborting."
            exit 1
        fi
    done

    log_info "Creating light-merge branch $target_branch from $base..."
    local base_ref=$(resolve_ref "$base") || { log_err "Error: Base $base not found"; exit 1; }
    
    git checkout -B "$target_branch" "$base_ref"
    
    LM_FEATURES=(${features[@]+"${features[@]}"})
    run_merge_loop "$target_branch" "$base" ${features[@]+"${features[@]}"}
}

run_merge_loop() {
    local target_branch=$1
    local base=$2
    shift 2
    local queue=("$@")
    local total=${#queue[@]}
    local i=0

    for feature in "${queue[@]}"; do
        i=$((i + 1))
        log_info "[$i/$total] Merging: $feature"
        
        local ref=$(resolve_ref "$feature")
        
        if ! git merge --no-ff --no-commit "$ref" -m "Temp merge $feature"; then
            log_err "!!! Conflict detected in $feature !!!"
            local remaining=("${queue[@]:$((i-1))}")
            local feat_content=$(printf "%s\n" ${LM_FEATURES[@]+"${LM_FEATURES[@]}"})
            local pend_content=$(printf "%s\n" ${remaining[@]+"${remaining[@]}"})
            save_state "$target_branch" "$base" "$feat_content" "$pend_content"
            log_warn "Manual steps:"
            log_info "  1. Resolve conflicts"
            log_info "  2. git add . && git commit"
            log_info "  3. git lm continue"
            exit 1
        fi
        
        if ! git diff --cached --quiet; then
            git commit --no-edit
        fi
    done

    # Finalize
    log_info "Finalizing squash merge..."
    git reset --soft "$(resolve_ref "$base")"
    
    local msg_list=""
    for f in ${LM_FEATURES[@]+"${LM_FEATURES[@]}"}; do msg_list="$msg_list\n- $f"; done
    printf "Integrated: $target_branch\n\nIncluded features:$msg_list" | git commit -F -
    
    local feat_content=$(printf "%s\n" ${LM_FEATURES[@]+"${LM_FEATURES[@]}"})
    save_state "$target_branch" "$base" "$feat_content" ""
    log_info "========================================"
    log_info "Success! Current branch: $target_branch"
}

continue_cmd() {
    if ! is_lm_branch; then log_err "Error: Not on a LM branch"; exit 1; fi
    local target_branch=$(get_current_branch)
    load_state "$target_branch" || { log_err "Error: No state found"; exit 1; }
    
    if [[ ${#LM_PENDING[@]} -eq 0 ]]; then
        log_info "Nothing to continue."
        exit 0
    fi

    if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
        log_err "Error: Merge in progress. Please resolve conflicts and commit first."
        exit 1
    fi

    log_info "Resuming merge loop for: ${LM_PENDING[*]}"
    run_merge_loop "$target_branch" "$LM_BASE" ${LM_PENDING[@]+"${LM_PENDING[@]}"}
}

status_cmd() {
    local full_name
    full_name=$(find_target_lm "${1:-}") || return 1

    if load_state "$full_name"; then
        echo "Branch  : $full_name"
        echo "Base    : $LM_BASE"
        echo "Features: ${LM_FEATURES[*]}"
        [[ ${#LM_PENDING[@]} -gt 0 ]] && log_warn "Pending : ${LM_PENDING[*]}"
    else
        log_err "Error: No state found for $full_name"
    fi
}

abort_cmd() {
    local target_branch=$(find_target_lm "${1:-}") || return 1
    load_state "$target_branch" && {
        git checkout "$LM_BASE"
        git branch -D "$target_branch"
        rm -rf "$(get_state_dir "$target_branch")"
        log_info "Aborted and cleaned up $target_branch."
    }
}

prune_cmd() {
    log_info "Pruning orphaned state files..."
    local count=0
    if [[ -d "$LM_STATE_ROOT" ]]; then
        for d in "$LM_STATE_ROOT"/*; do
            [[ -d "$d" ]] || continue
            local safe_name=$(basename "$d")
            # Restore the name (though approximate since multiple names can map to same safe name)
            # Actually, the best way is to check if any branch matches the directory name pattern
            local found=0
            local branches=($(git branch --list --format='%(refname:short)'))
            for b in ${branches[@]+"${branches[@]}"}; do
                local s="${b//[\/\\ :*?\"<>|]/__}"
                if [[ "$s" == "$safe_name" ]]; then
                    found=1; break
                fi
            done
            
            if [[ $found -eq 0 ]]; then
                rm -rf "$d"
                count=$((count + 1))
            fi
        done
    fi
    find "$LM_STATE_ROOT" -type d -empty -delete 2>/dev/null || true
    log_info "Cleaned up $count orphaned tasks."
}

push_cmd() {
    local target_branch=$(get_current_branch)
    log_info "Pushing to origin..."
    git push origin "$target_branch"
}

pick_cmd() {
    local base="$1"; shift
    if [[ $# -lt 1 ]]; then
        log_err "Usage: git lm pick [--base branch] <name>"
        exit 1
    fi
    local name=$1
    local selected_features=()

    # Get both local and remote branches (excluding HEAD and current branch)
    local branch_list=$(git branch -a --format='%(refname:short)' | sed 's|^origin/||' | sort -u | grep -v "HEAD")

    if command -v fzf >/dev/null 2>&1; then
        log_info "Picking features using fzf (TAB to multi-select, ENTER to confirm)..."
        local selected=$(echo "$branch_list" | fzf -m --header="Select branches to merge into '$name'")
        if [[ -z "$selected" ]]; then log_warn "Aborted."; exit 0; fi
        
        # Correctly capture multi-line output into array
        while read -r line; do
            [[ -n "$line" ]] && selected_features+=("$line")
        done <<< "$selected"
    else
        log_info "fzf not found. Using native numbered list picker..."
        local branches=($branch_list)
        for i in "${!branches[@]}"; do
            printf "  [%2d] %s\n" "$((i+1))" "${branches[$i]}"
        done
        printf "\nEnter branch numbers to merge (e.g., 1 3 5), or 'q' to quit: "
        read -r input
        if [[ "$input" == "q" ]]; then exit 0; fi
        for idx in $input; do
            if [[ "$idx" -gt 0 && "$idx" -le "${#branches[@]}" ]]; then
                selected_features+=("${branches[$((idx-1))]}")
            fi
        done
    fi

    if [[ ${#selected_features[@]} -eq 0 ]]; then
        log_warn "No features selected. Aborting."
        exit 0
    fi

    log_info "Selected features: ${selected_features[*]}"
    if [[ -z "$base" ]]; then
        # Try to load existing state to reuse the base branch
        local full_name=$(resolve_lm_branch "$name")
        if load_state "$full_name" >/dev/null 2>&1; then
            base="$LM_BASE"
            log_info "Reusing existing base: $base"
        else
            base=$(git default-branch 2>/dev/null || git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo "main")
        fi
    fi
    do_merge "$name" "$base" ${selected_features[@]+"${selected_features[@]}"}
}

refresh_cmd() {
    local base=""
    local args=()
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "--base" ]]; then
            base="$2"; shift 2
        else
            args+=("$1"); shift
        fi
    done

    local full_name
    full_name=$(find_target_lm "${args[0]:-}") || return 1
    load_state "$full_name" || { log_err "Error: No state found for $full_name"; exit 1; }
    
    [[ -n "$base" ]] && LM_BASE="$base"
    
    local has_origin=0
    if git remote | grep -q "^origin$"; then
        has_origin=1
        log_info "Refreshing base and features for $full_name from origin..."
        # Update base (local branch)
        git fetch origin "$LM_BASE:$LM_BASE" 2>/dev/null || true
    else
        log_warn "No remote 'origin' found. Using local branches only."
    fi
    
    # Update features in a single batch fetch for performance
    local fetch_args=()
    for f in ${LM_FEATURES[@]+"${LM_FEATURES[@]}"}; do
        if [[ $has_origin -eq 1 ]]; then
            fetch_args+=("$f:$f")
        fi
    done
    
    if [[ ${#fetch_args[@]} -gt 0 ]]; then
        log_info "Batch fetching features from origin..."
        git fetch origin ${fetch_args[@]} 2>/dev/null || true
    fi
    
    local name="${full_name#$LM_PREFIX}"; name="${name#$LM_USER-}"
    do_merge "$name" "$LM_BASE" ${LM_FEATURES[@]+"${LM_FEATURES[@]}"}
}

clear_cmd() {
    local branches=$(git branch --list "${LM_PREFIX}*" --format='%(refname:short)')
    if [[ -z "$branches" && ! -d "$LM_STATE_ROOT" ]]; then
        log_info "No light-merge tasks found."
        return
    fi

    log_warn "This will delete ALL local branches starting with '$LM_PREFIX' and the state directory '$LM_STATE_ROOT'."
    printf "Are you sure? [y/N] "
    read -r opt
    if [[ "$opt" != "y" && "$opt" != "Y" ]]; then
        log_info "Aborted."
        return
    fi
    
    if [[ -n "$branches" ]]; then
        local current=$(get_current_branch)
        if [[ "$current" == "$LM_PREFIX"* ]]; then
             local default=$(git default-branch 2>/dev/null || git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo "master")
             log_info "Switching to $default..."
             git checkout "$default" 2>/dev/null || git checkout main 2>/dev/null || git checkout master 2>/dev/null
        fi
        echo "$branches" | xargs git branch -D
    fi
    
    rm -rf "$LM_STATE_ROOT"
    log_info "All light-merge tasks cleared."
}

create_cmd() {
    local base=""
    local args=()
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "--base" ]]; then
            base="$2"; shift 2
        else
            args+=("$1"); shift
        fi
    done

    if [[ ${#args[@]} -lt 1 ]]; then show_help; exit 1; fi
    local name="${args[0]}"
    local features=()
    if [[ ${#args[@]} -gt 1 ]]; then
        for ((i=1; i<${#args[@]}; i++)); do
            features+=("${args[$i]}")
        done
    fi

    if [[ -z "$base" ]]; then
        # Try to load existing state to reuse the base branch
        local full_name=$(resolve_lm_branch "$name")
        if load_state "$full_name" >/dev/null 2>&1; then
            base="$LM_BASE"
            log_info "Reusing existing base: $base"
        else
            base=$(git default-branch 2>/dev/null || git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo "main")
        fi
    fi
    
    if [[ ${#features[@]} -eq 0 && "$name" != "--help" && "$name" != "-h" ]]; then
        # If only name is provided, it might be an attempt to use 'git lm <name>' 
        # but the user didn't provide features. However, do_merge requires features.
        show_help
        exit 1
    fi

    do_merge "$name" "$base" ${features[@]+"${features[@]}"}
}

list_cmd() {
    local branches=$(git branch --list "${LM_PREFIX}*" --format='%(refname:short)')
    if [[ -z "$branches" ]]; then
        log_info "No light-merge branches found."
        return
    fi
    
    log_info "Available light-merge branches:"
    local current=$(get_current_branch)
    while read -r b; do
        local prefix="  "
        [[ "$b" == "$current" ]] && prefix="* "
        
        # Try to load state to show features
        if load_state "$b" >/dev/null 2>&1; then
            # Color the branch name if it's current
            if [[ "$b" == "$current" ]]; then
                printf "\e[32m%s%-30s\e[0m [%s] (%s)\n" "$prefix" "$b" "$LM_BASE" "${LM_FEATURES[*]}"
            else
                printf "%s%-30s [%s] (%s)\n" "$prefix" "$b" "$LM_BASE" "${LM_FEATURES[*]}"
            fi
        else
            printf "%s%-30s\n" "$prefix" "$b"
        fi
    done <<< "$branches"
}

add_cmd() {
    local feature="${1:-}"
    local target_task="${2:-}"
    
    # 1. Resolve feature: default to current branch if not provided or if '.' is used
    if [[ -z "$feature" || "$feature" == "." ]]; then
        feature=$(get_current_branch)
        if [[ -z "$feature" ]]; then log_err "Error: Not on a branch."; return 1; fi
        if [[ "$feature" == "$LM_PREFIX"* ]]; then
            log_err "Error: Cannot add a light-merge branch to itself."
            return 1
        fi
    fi
    
    # 2. Resolve target task
    local full_name
    full_name=$(find_target_lm "$target_task") || return 1
    
    # 3. Load state and check if already exists
    load_state "$full_name" || { log_err "Error: No state found for $full_name"; return 1; }

    if [[ "$feature" == "$LM_BASE" ]]; then
        log_err "Error: '$feature' is the base branch of $full_name. Cannot add base as a feature."
        return 1
    fi

    for f in ${LM_FEATURES[@]+"${LM_FEATURES[@]}"}; do
        if [[ "$f" == "$feature" ]]; then
            log_info "Feature $feature is already in $full_name. Refreshing..."
            local name="${full_name#$LM_PREFIX}"; name="${name#$LM_USER-}"
            do_merge "$name" "$LM_BASE" ${LM_FEATURES[@]+"${LM_FEATURES[@]}"}
            return
        fi
    done
    
    # 4. Add and rebuild
    LM_FEATURES+=("$feature")
    local name="${full_name#$LM_PREFIX}"; name="${name#$LM_USER-}"
    log_info "Adding $feature to $full_name..."
    do_merge "$name" "$LM_BASE" ${LM_FEATURES[@]+"${LM_FEATURES[@]}"}
}

rm_cmd() {
    local feature="${1:-}"
    local target_task="${2:-}"
    
    # 1. Resolve feature: default to current branch if not provided or if '.' is used
    if [[ -z "$feature" || "$feature" == "." ]]; then
        feature=$(get_current_branch)
    fi
    
    # 2. Resolve target task
    local full_name
    full_name=$(find_target_lm "$target_task") || return 1
    
    # 3. Load state and filter
    load_state "$full_name" || { log_err "Error: No state found for $full_name"; return 1; }

    if [[ "$feature" == "$LM_BASE" ]]; then
        log_err "Error: '$feature' is the base branch of $full_name. To change the base, use 'git lm rebase --base <new_base>'."
        return 1
    fi

    local new_features=()
    local found=0
    for f in ${LM_FEATURES[@]+"${LM_FEATURES[@]}"}; do
        if [[ "$f" == "$feature" ]]; then
            found=1
        else
            new_features+=("$f")
        fi
    done
    
    if [[ $found -eq 0 ]]; then
        log_warn "Feature $feature not found in $full_name."
        return
    fi
    
    # 4. Rebuild
    local name="${full_name#$LM_PREFIX}"; name="${name#$LM_USER-}"
    log_info "Removing $feature from $full_name..."
    do_merge "$name" "$LM_BASE" ${new_features[@]+"${new_features[@]}"}
}

main() {
    ensure_git_repo
    [[ $# -eq 0 ]] && { show_help; exit 0; }

    case "$1" in
        create|new|mk) shift; create_cmd "$@" ;;
        add) shift; add_cmd "$@" ;;
        rm)  shift; rm_cmd "$@" ;;
        status|st) shift; status_cmd "$@" ;;
        list|ls) list_cmd ;;
        abort)
            shift
            local target_task="${1:-}"
            abort_cmd "$target_task"
            ;;
        continue|con) continue_cmd ;;
        push)
            local b=$(find_target_lm "${2:-}") || exit 1
            log_info "Pushing $b to origin..."
            git push origin --delete "$b" 2>/dev/null || true
            git checkout "$b" 2>/dev/null
            push_cmd
            ;;
        refresh|rebase|rf) shift; refresh_cmd "$@" ;;
        clear)   clear_cmd ;;
        pick)
            shift
            local base=""
            local args=()
            while [[ $# -gt 0 ]]; do
                if [[ "$1" == "--base" ]]; then
                    base="$2"; shift 2
                else
                    args+=("$1"); shift
                fi
            done
            pick_cmd "$base" ${args[@]+"${args[@]}"}
            ;;
        prune) prune_cmd ;;
        help|--help|-h) show_help ;;
        *) create_cmd "$@" ;;
    esac
}

main "$@"
