#!/usr/bin/env bash

set -euo pipefail

# git-light-merge (git lm)
# 
# A tool to automate merging multiple branches into a single light-merge branch.
# The result is a single squash commit on the light-merge branch.
#
# Requires modern Bash (Bash 5.0+). Optimized for Bash 5.x syntax and performance.

if (( BASH_VERSINFO[0] < 5 )); then
    printf "Error: git-light-merge requires Bash 5.0 or higher. Current version: %s\n" "$BASH_VERSION" >&2
    exit 1
fi

LM_NAME_TEMPLATE="${GIT_LM_TEMPLATE:-"light-merge/{name}"}"
LM_PREFIX="${LM_NAME_TEMPLATE%%\{*}" 
LM_GIT_DIR=""
LM_PENDING_ROOT=""
GIT_LM_PICKER_PLUGIN="${GIT_LM_PICKER_PLUGIN:-}"
LM_BASE=""
declare -a LM_FEATURES=()
declare -a LM_PENDING=()
declare -A LM_RESOLVED_REFS=()
declare -A LM_LIST_SHA_CACHE=()
declare -A LM_LIST_INFO_CACHE=()
declare -A LM_LIST_BASE_CACHE=()
declare -A LM_LIST_FEATURES_CACHE=()
declare -A LM_LIST_ORIGIN_REF_CACHE=()
LM_RESOLVED_BRANCH=""


ensure_picker_plugin() {
    if [[ -z "$GIT_LM_PICKER_PLUGIN" ]]; then
        local script_dir="${BASH_SOURCE[0]%/*}"
        if [[ "$script_dir" == "${BASH_SOURCE[0]}" ]]; then
            script_dir="."
        fi
        script_dir=$(cd "$script_dir" && pwd)
        GIT_LM_PICKER_PLUGIN="$script_dir/git-lm-picker"
    fi
}

# Color output functions
log_info() { printf "\e[32m%b\e[0m\n" "$*" >&2; }
log_warn() { printf "\e[33m%b\e[0m\n" "$*" >&2; }
log_err()  { printf "\e[31m%b\e[0m\n" "$*" >&2; }

feature_list_contains() {
    local features="$1"
    local target="$2"
    local feature_array=()
    local feature

    read -ra feature_array <<< "$features"
    for feature in "${feature_array[@]}"; do
        [[ "$feature" == "$target" ]] && return 0
    done

    return 1
}

get_feature_difference() {
    local features="$1"
    local compared_features="$2"
    local difference_var="$3"
    local feature_array=()
    local differences=()
    local feature

    read -ra feature_array <<< "$features"
    for feature in "${feature_array[@]}"; do
        if ! feature_list_contains "$compared_features" "$feature"; then
            differences+=("$feature")
        fi
    done

    printf -v "$difference_var" "%s" "${differences[*]}"
}

format_feature_list() {
    local features="$1"
    local formatted_var="$2"
    local difference_features="${3:-}"
    local feature_array=()
    local formatted=""
    local f

    read -ra feature_array <<< "$features"
    for f in "${feature_array[@]}"; do
        [[ -n "$formatted" ]] && formatted+=" "
        local formatted_feature=""
        format_feature "$f" formatted_feature "$difference_features"
        formatted+="$formatted_feature"
    done

    printf -v "$formatted_var" "%s" "$formatted"
}

print_features_line() {
    local features="$1"
    local formatted_features=""

    format_feature_list "$features" formatted_features
    printf "Features: %b\n" "$formatted_features"
}

format_feature() {
    local feature="$1"
    local formatted_var="$2"
    local difference_features="${3:-}"

    if ! list_feature_has_origin_ref "$feature"; then
        printf -v "$formatted_var" "%s" "\e[31m${feature}\e[0m"
    elif feature_list_contains "$difference_features" "$feature"; then
        printf -v "$formatted_var" "%s" "\e[35m${feature}\e[0m"
    else
        printf -v "$formatted_var" "%s" "\e[32m${feature}\e[0m"
    fi
}

detect_output_width() {
    local width="${GIT_LM_WRAP_WIDTH:-}"

    if [[ ! "$width" =~ ^[0-9]+$ ]]; then
        width="${COLUMNS:-}"
    fi

    if [[ ! "$width" =~ ^[0-9]+$ ]] && command -v tput >/dev/null 2>&1; then
        width=$(tput cols 2>/dev/null || true)
    fi

    if [[ ! "$width" =~ ^[0-9]+$ && -r /dev/tty ]]; then
        local rows=""
        local cols=""
        read -r rows cols < <(stty size </dev/tty 2>/dev/null || true)
        width="$cols"
    fi

    if [[ ! "$width" =~ ^[0-9]+$ || $width -lt 20 ]]; then
        return 1
    fi

    printf "%s" "$width"
}

print_wrapped_features_line() {
    local indent="$1"
    local features="$2"
    local difference_features="${3:-}"
    local feature_array=()
    local max_width
    local prefix="${indent}features: "
    local continuation="${indent}          "
    local current="$prefix"
    local current_raw_len=${#prefix}
    local has_word=0
    local f

    read -ra feature_array <<< "$features"
    [[ ${#feature_array[@]} -eq 0 ]] && return 0

    if ! max_width=$(detect_output_width); then
        local formatted_features=""
        format_feature_list "$features" formatted_features "$difference_features"
        printf "%b%b\n" "$prefix" "$formatted_features"
        return 0
    fi

    for f in "${feature_array[@]}"; do
        local formatted_feature=""
        local separator=""
        local separator_len=0
        format_feature "$f" formatted_feature "$difference_features"

        if [[ $has_word -eq 1 ]]; then
            separator=" "
            separator_len=1
        fi

        if [[ $has_word -eq 1 && $((current_raw_len + separator_len + ${#f})) -gt $max_width ]]; then
            printf "%b\n" "$current"
            current="$continuation$formatted_feature"
            current_raw_len=$(( ${#continuation} + ${#f} ))
        else
            current+="$separator$formatted_feature"
            current_raw_len=$((current_raw_len + separator_len + ${#f}))
        fi
        has_word=1
    done

    printf "%b\n" "$current"
}

print_summary_state_line() {
    local indent="$1"
    local leading="$2"
    local label="$3"
    local info="$4"
    local base="$5"
    local features="$6"
    local features_indent="${7:-$indent}"
    local difference_features="${8:-}"

    local label_color=""
    local label_text=""
    if [[ "$label" == "local" ]]; then
        label_color="\e[36m"
        label_text="local:  "
    elif [[ "$label" == "synced" ]]; then
        label_color="\e[32m"
        label_text="synced:"
    else
        label_color="\e[34m"
        label_text="remote: "
    fi

    local line_prefix="$indent"
    if [[ -n "$leading" ]]; then
        line_prefix="$leading"
    fi

    local info_formatted=""
    if [[ -n "$info" ]]; then
        info_formatted=$(printf "\e[90m%-35s\e[0m" "$info")
    else
        info_formatted=$(printf "%-35s" "")
    fi

    local base_formatted=""
    if [[ -n "$base" ]]; then
        base_formatted="[\e[1;36m${base}\e[0m]"
    fi

    printf "%b%b%s\e[0m %b %b\n" "$line_prefix" "$label_color" "$label_text" "$info_formatted" "$base_formatted"
    print_wrapped_features_line "$features_indent" "$features" "$difference_features"
}

format_state_line() {
    local indent="$1"
    local label="$2"
    local info="$3"
    local base="$4"
    local features="$5"
    local difference_features="${6:-}"
    
    local label_color=""
    local label_text=""
    if [[ "$label" == "local" ]]; then
        label_color="\e[36m" # Cyan
        label_text="local:  "
    elif [[ "$label" == "synced" ]]; then
        label_color="\e[32m" # Green
        label_text="synced:"
    else
        label_color="\e[34m" # Blue
        label_text="remote: "
    fi
    
    local info_formatted=""
    if [[ -n "$info" ]]; then
        info_formatted=$(printf "\e[90m%-35s\e[0m" "$info")
    else
        info_formatted=$(printf "%-35s" "")
    fi
    
    local base_formatted=""
    if [[ -n "$base" ]]; then
        base_formatted="[\e[1;36m${base}\e[0m]"
    fi
    
    local features_formatted=""
    if [[ -n "$features" ]]; then
        local formatted_features=""
        format_feature_list "$features" formatted_features "$difference_features"
        features_formatted="(${formatted_features})"
    fi
    
    printf "%s%b%s\e[0m %b %b %b\n" "$indent" "$label_color" "$label_text" "$info_formatted" "$base_formatted" "$features_formatted"
}

show_help() {
    cat <<EOF
Usage: git lm [command] [options]

Commands:
  git lm create|new|mk <name> <features...>    Create and merge light-merge branch
  git lm pick [name] [--base branch]           Interactively pick features
  git lm add [feature] [name]                  Add feature to task ('.' for current branch)
  git lm rm [feature] [name]                   Remove feature from task ('.' for current)
  git lm status|st [name]                      Show status (auto-selects if unique)
  git lm refresh|rf [name] [--base branch]     Update base/features and rebuild task
  git lm list|ls                               List all light-merge tasks
  git lm push [name]                           Push local task to remote (override remote)
  git lm pull [name]                           Pull remote task to local (override local)
  git lm sync [name]                           Sync local/remote task (newest generated commit wins)
  git lm continue|con                          Continue after resolving conflicts
  git lm abort [name] [-r]                     Stop and delete a task; -r also deletes remote branch
  git lm clear                                 Delete ALL local light-merge branches
  git lm prune                                 Cleanup orphaned in-progress conflict files

Options:
  --base <branch>   Specify base branch
EOF
}

ensure_git_repo() {
    LM_GIT_DIR=$(git rev-parse --git-dir 2>/dev/null) || {
        log_err "Error: Not a git repository"
        exit 1
    }
    LM_PENDING_ROOT="$LM_GIT_DIR/light-merge-pending"
}

resolve_ref() {
    local name="$1"
    # 1. Try resolving as is (local branch, tag, etc.)
    if git rev-parse --verify "$name" >/dev/null 2>&1; then
        echo "$name"
        return 0
    fi
    # 2. Try origin prefix
    if git rev-parse --verify "origin/$name" >/dev/null 2>&1; then
        echo "origin/$name"
        return 0
    fi
    # 3. Try fetching on-demand
    log_info "Ref $name not found, trying to fetch from origin..."
    if git fetch origin "$name" >/dev/null 2>&1; then
        echo "FETCH_HEAD"
        return 0
    fi
    return 1
}

feature_has_origin_ref() {
    local feature="$1"
    git show-ref --verify -q "refs/remotes/origin/$feature" 2>/dev/null
}

is_remote_backed_feature() {
    local feature="$1"
    local resolved_ref="${2:-}"

    if [[ "$resolved_ref" == "FETCH_HEAD" || "$resolved_ref" == "origin/"* || "$resolved_ref" == "refs/remotes/origin/"* ]]; then
        return 0
    fi

    feature_has_origin_ref "$feature"
}

require_remote_backed_feature() {
    local feature="$1"
    local resolved_ref="${2:-}"

    if ! is_remote_backed_feature "$feature" "$resolved_ref"; then
        log_err "Error: Feature '$feature' is local-only. Push it to origin first before using light-merge."
        return 1
    fi
}

validate_loaded_state_features() {
    local task="$1"
    local missing=()
    local f

    for f in "${LM_FEATURES[@]}"; do
        if ! feature_has_origin_ref "$f"; then
            missing+=("$f")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        log_err "Error: Task '$task' contains local-only feature(s): ${missing[*]}"
        log_err "Push them to origin first, then run 'git fetch origin' and try again."
        return 1
    fi
}

parse_lm_state_subject() {
    local subject="$1"
    local base_var="$2"
    local features_var="$3"
    local pattern='LM-State:[[:space:]]*([^;]+);[[:space:]]*(.*)'

    if [[ "$subject" =~ $pattern ]]; then
        local base="${BASH_REMATCH[1]}"
        local features="${BASH_REMATCH[2]}"
        base="${base%"${base##*[![:space:]]}"}"
        features="${features%"${features##*[![:space:]]}"}"
        printf -v "$base_var" "%s" "$base"
        printf -v "$features_var" "%s" "$features"
        [[ -n "$base" ]] && return 0
    fi

    return 1
}

list_feature_has_origin_ref() {
    local feature="$1"
    [[ -n "${LM_LIST_ORIGIN_REF_CACHE[refs/remotes/origin/$feature]:-}" ]]
}

load_origin_ref_cache() {
    LM_LIST_ORIGIN_REF_CACHE=()

    local origin_refs
    origin_refs=$(git for-each-ref --format='%(refname)' refs/remotes/origin 2>/dev/null || true)
    local origin_ref
    while IFS= read -r origin_ref; do
        [[ -n "$origin_ref" ]] && LM_LIST_ORIGIN_REF_CACHE["$origin_ref"]=1
    done <<< "$origin_refs"
}

get_missing_origin_features() {
    local features="$1"
    local missing_var="$2"
    local missing_features=()
    local feature_array=()
    local f

    read -ra feature_array <<< "$features"
    for f in "${feature_array[@]}"; do
        if ! list_feature_has_origin_ref "$f"; then
            missing_features+=("$f")
        fi
    done

    printf -v "$missing_var" "%s" "${missing_features[*]}"
}

warn_missing_origin_features() {
    local indent="$1"
    local _task="$2"
    local features="$3"
    local missing=""

    get_missing_origin_features "$features" missing
    if [[ -n "$missing" ]]; then
        log_warn "${indent}Warning: missing on origin: $missing"
    fi
}

warn_missing_origin_feature_sets() {
    local indent="$1"
    shift
    local combined_features=""
    local seen_features=()
    local feature_array=()
    local features
    local f
    local seen

    for features in "$@"; do
        read -ra feature_array <<< "$features"
        for f in "${feature_array[@]}"; do
            seen=0
            local existing
            for existing in "${seen_features[@]}"; do
                if [[ "$existing" == "$f" ]]; then
                    seen=1
                    break
                fi
            done
            if [[ $seen -eq 0 ]]; then
                seen_features+=("$f")
                [[ -n "$combined_features" ]] && combined_features+=" "
                combined_features+="$f"
            fi
        done
    done

    warn_missing_origin_features "$indent" "" "$combined_features"
}

get_lm_state_features_for_side() {
    local full_branch="$1"
    local side="$2"
    local features_var="$3"
    local ref=""
    local subject=""
    local state_base=""
    local state_features=""

    if [[ "$side" == "local" ]]; then
        if load_pending_state "$full_branch"; then
            printf -v "$features_var" "%s" "${LM_FEATURES[*]}"
            return 0
        fi
        ref="refs/heads/$full_branch"
    else
        ref="refs/remotes/origin/$full_branch"
    fi

    if ! git show-ref --verify -q "$ref" 2>/dev/null; then
        return 1
    fi

    subject=$(git log -1 --format=%s "$ref" 2>/dev/null || true)
    if parse_lm_state_subject "$subject" state_base state_features; then
        printf -v "$features_var" "%s" "$state_features"
        return 0
    fi

    return 1
}

get_missing_origin_features_for_side() {
    local full_branch="$1"
    local side="$2"
    local missing_var="$3"
    local side_features=""
    local side_missing=""

    printf -v "$missing_var" "%s" ""
    get_lm_state_features_for_side "$full_branch" "$side" side_features || return 0
    get_missing_origin_features "$side_features" side_missing
    printf -v "$missing_var" "%s" "$side_missing"
}

guard_lm_state_has_no_missing_origin_features() {
    local full_branch="$1"
    local side="$2"
    local action="$3"
    local missing=""

    load_origin_ref_cache
    get_missing_origin_features_for_side "$full_branch" "$side" missing
    if [[ -n "$missing" ]]; then
        print_lm_task_summary_block "Summary" "$full_branch"
        log_err "Error: Cannot $action: $side light-merge state references feature branch(es) missing on origin: $missing"
        return 1
    fi
}

print_lm_task_summary_lines() {
    local indent="$1"
    local full_branch="$2"
    local leading="${3:-}"
    local local_ref="refs/heads/$full_branch"
    local remote_ref="refs/remotes/origin/$full_branch"

    local has_local=0
    local has_remote=0
    local local_sha=""
    local remote_sha=""
    local local_info=""
    local remote_info=""
    local local_base=""
    local remote_base=""
    local local_features=""
    local remote_features=""

    local refs
    refs=$(git for-each-ref --format='%(refname)|%(objectname)|%(authorname)|%(authordate:relative)|%(contents:subject)' "$local_ref" "$remote_ref" 2>/dev/null || true)
    local ref sha author rel_time subject
    while IFS='|' read -r ref sha author rel_time subject; do
        [[ -z "$ref" ]] && continue
        local state_base=""
        local state_features=""
        parse_lm_state_subject "$subject" state_base state_features || true

        if [[ "$ref" == "$local_ref" ]]; then
            has_local=1
            local_sha="$sha"
            [[ -n "$author" || -n "$rel_time" ]] && local_info="$rel_time by $author"
            local_base="$state_base"
            local_features="$state_features"
        elif [[ "$ref" == "$remote_ref" ]]; then
            has_remote=1
            remote_sha="$sha"
            [[ -n "$author" || -n "$rel_time" ]] && remote_info="$rel_time by $author"
            remote_base="$state_base"
            remote_features="$state_features"
        fi
    done <<< "$refs"

    if [[ $has_local -eq 1 ]] && load_pending_state "$full_branch"; then
        local_base="$LM_BASE"
        local_features="${LM_FEATURES[*]}"
        [[ -n "$local_info" ]] || local_info=$(get_commit_info_str "$local_ref")
    fi

    if [[ $has_local -eq 0 && $has_remote -eq 0 ]]; then
        return 1
    fi

    if [[ $has_local -eq 1 && $has_remote -eq 1 && "$local_sha" == "$remote_sha" ]]; then
        local info_str="${local_info:-$remote_info}"
        local synced_base="${local_base:-$remote_base}"
        local synced_features="${local_features:-$remote_features}"
        print_summary_state_line "$indent" "$leading" "synced" "$info_str" "$synced_base" "$synced_features"
        warn_missing_origin_feature_sets "$indent" "$synced_features"
        return 0
    fi

    local local_difference_features=""
    local remote_difference_features=""
    if [[ $has_local -eq 1 && $has_remote -eq 1 ]]; then
        get_feature_difference "$local_features" "$remote_features" local_difference_features
        get_feature_difference "$remote_features" "$local_features" remote_difference_features
    fi

    local features_indent="$indent"
    if [[ $has_local -eq 1 && $has_remote -eq 1 ]]; then
        if [[ -n "$leading" ]]; then
            printf "%b\n" "$leading"
        fi
        leading=""
        features_indent="${indent}  "
    fi

    local first_leading="$leading"
    if [[ $has_local -eq 1 ]]; then
        print_summary_state_line "$indent" "$first_leading" "local" "$local_info" "$local_base" "$local_features" "$features_indent" "$local_difference_features"
        first_leading=""
    fi

    if [[ $has_remote -eq 1 ]]; then
        print_summary_state_line "$indent" "$first_leading" "remote" "$remote_info" "$remote_base" "$remote_features" "$features_indent" "$remote_difference_features"
    fi

    warn_missing_origin_feature_sets "$indent" "$local_features" "$remote_features"
}

print_lm_task_summary_block() {
    local title="$1"
    local target_branch="$2"

    printf "\e[90m========================================\e[0m\n" >&2
    [[ -n "$title" ]] && printf "\e[1;32m%s\e[0m\n" "$title" >&2
    printf "Target: \e[1;33m%s\e[0m\n" "$target_branch" >&2
    load_origin_ref_cache
    print_lm_task_summary_lines "" "$target_branch" >&2
    printf "\e[90m========================================\e[0m\n" >&2
}

get_pending_state_values() {
    local name="$1"
    local base_var="$2"
    local features_var="$3"
    local pending_dir
    get_pending_dir pending_dir "$name"

    if [[ ! -f "$pending_dir/pending" || ! -s "$pending_dir/pending" ]]; then
        return 1
    fi

    local base=""
    local features=()
    local line
    if [[ -f "$pending_dir/base" ]]; then
        IFS= read -r base < "$pending_dir/base" || true
    fi
    if [[ -f "$pending_dir/features" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -n "$line" ]] && features+=("$line")
        done < "$pending_dir/features"
    fi

    printf -v "$base_var" "%s" "$base"
    printf -v "$features_var" "%s" "${features[*]}"
    [[ -n "$base" ]] && return 0
    return 1
}

print_merge_success_summary() {
    local target_branch="$1"
    local _base="$2"
    local _features="$3"

    print_lm_task_summary_block "Success!" "$target_branch"
}

get_current_branch() {
    git branch --show-current
}

is_lm_branch() {
    local branch=$(get_current_branch)
    [[ -n "$branch" && "$branch" == "$LM_PREFIX"* ]]
}

get_lm_name() {
    get_current_branch
}

get_default_base_branch() {
    local ref
    ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null || echo "")
    local default_branch="${ref#refs/remotes/origin/}"
    printf "%s\n" "${default_branch:-main}"
}

get_pending_dir() {
    local var_name=$1
    local full_name=$2
    local safe_name="${full_name//[\/\\ :*?\"<>|]/__}"
    printf -v "$var_name" "%s" "$LM_PENDING_ROOT/$safe_name"
}

clear_pending_state() {
    local name=$1
    local pending_dir
    get_pending_dir pending_dir "$name"
    rm -rf "$pending_dir"
}

resolve_lm_branch() {
    local var_name=$1
    local name=$2
    if [[ "$name" == "$LM_PREFIX"* ]]; then
        name=$(get_lm_task_name "$name")
    fi
    local target="${LM_NAME_TEMPLATE//\{name\}/$name}"
    printf -v "$var_name" "%s" "$target"
}

get_lm_task_name() {
    local full_name="$1"
    local suffix="${full_name#$LM_PREFIX}"
    local name_prefix="${LM_NAME_TEMPLATE#$LM_PREFIX}"
    name_prefix="${name_prefix%%\{name\}*}"
    echo "${suffix#$name_prefix}"
}

# Helper to find the target LM branch when not on one
# Scans both local and remote-tracking branches so pull/sync work on remote-only tasks
find_target_lm() {
    local input_name="${1:-}"
    LM_RESOLVED_BRANCH=""
    
    if [[ -n "$input_name" ]]; then
        resolve_lm_branch LM_RESOLVED_BRANCH "$input_name"
        return 0
    fi
    
    local current_branch
    current_branch=$(git branch --show-current 2>/dev/null || echo "")
    if [[ -n "$current_branch" && "$current_branch" == "$LM_PREFIX"* ]]; then
        LM_RESOLVED_BRANCH="$current_branch"
        return 0
    fi
    
    # Collect unique task names from local + remote branches
    declare -A seen_tasks
    local task_list=""
    local all_refs
    all_refs=$(git for-each-ref --format='%(refname:short)' "refs/heads/${LM_PREFIX}*" "refs/remotes/origin/${LM_PREFIX}*" 2>/dev/null || true)
    while read -r ref; do
        [[ -z "$ref" ]] && continue
        local branch="$ref"
        # Strip 'origin/' prefix for remote refs to get the canonical branch name
        if [[ "$branch" == "origin/${LM_PREFIX}"* ]]; then
            branch="${branch#origin/}"
        fi
        local task=$(get_lm_task_name "$branch")
        if [[ -z "${seen_tasks[$task]:-}" ]]; then
            seen_tasks["$task"]="$branch"
            task_list="$task_list$task"$'\n'
        fi
    done <<< "$all_refs"
    
    local task_count=0
    if [[ -n "$task_list" ]]; then
        task_count=$(printf "%s" "$task_list" | grep -c . 2>/dev/null || true)
    fi
    
    if [[ $task_count -eq 0 ]]; then
        log_err "Error: No light-merge tasks found."
        return 1
    elif [[ $task_count -eq 1 ]]; then
        local only_task
        only_task=$(printf "%s" "$task_list" | tr -d '\n')
        local resolved
        resolve_lm_branch resolved "$only_task"
        log_info "Auto-selecting task: $resolved"
        LM_RESOLVED_BRANCH="$resolved"
        return 0
    else
        local choice=""
        local exit_code=0
        ensure_picker_plugin
        if [[ -x "$GIT_LM_PICKER_PLUGIN" ]]; then
            choice=$(printf "%s" "$task_list" | "$GIT_LM_PICKER_PLUGIN" --header "Select light-merge task:" --single)
            exit_code=$?
        fi
        
        if [[ $exit_code -ne 0 ]]; then
            log_warn "Aborted."
            return 1
        fi
        
        if [[ -n "$choice" ]]; then
            resolve_lm_branch LM_RESOLVED_BRANCH "$choice"
            return 0
        else
            log_err "Error: No task selected."
            return 1
        fi
    fi
}

save_pending_state() {
    # Only used when a merge conflict occurs to track in-progress state
    local name=$1
    local base=$2
    local features_content="$3"
    local pending_content="$4"
    local pending_dir
    get_pending_dir pending_dir "$name"
    mkdir -p "$pending_dir"
    echo "$base" > "$pending_dir/base"
    printf "%s" "$features_content" > "$pending_dir/features"
    printf "%s" "$pending_content" > "$pending_dir/pending"
}

load_pending_state() {
    # Loads in-progress conflict state from local pending files
    local name=$1
    local pending_dir
    get_pending_dir pending_dir "$name"
    if [[ ! -f "$pending_dir/pending" || ! -s "$pending_dir/pending" ]]; then
        return 1
    fi
    LM_BASE=$(cat "$pending_dir/base")
    LM_FEATURES=()
    while read -r line || [[ -n "$line" ]]; do [[ -n "$line" ]] && LM_FEATURES+=("$line"); done < "$pending_dir/features"
    LM_PENDING=()
    while read -r line || [[ -n "$line" ]]; do [[ -n "$line" ]] && LM_PENDING+=("$line"); done < "$pending_dir/pending"
    return 0
}

load_state() {
    local name=$1
    LM_BASE=""
    LM_FEATURES=()
    LM_PENDING=()
    
    # 1. Check for in-progress conflict state first
    if load_pending_state "$name"; then
        return 0
    fi
    
    # 2. Load from branch commit message (local branch preferred, fallback to remote-tracking)
    local ref=""
    if [[ "$name" == "origin/"* ]]; then
        ref="refs/remotes/$name"
    elif [[ "$name" == "refs/"* ]]; then
        ref="$name"
    else
        ref="refs/heads/$name"
        if ! git show-ref --verify -q "$ref" 2>/dev/null; then
            ref="refs/remotes/origin/$name"
        fi
    fi
    
    if git show-ref --verify -q "$ref" 2>/dev/null; then
        local msg
        msg=$(git log -1 --format=%B "$ref" 2>/dev/null)
        local pattern='LM-State:[[:space:]]*([^;]+);[[:space:]]*(.*)'
        if [[ "$msg" =~ $pattern ]]; then
            LM_BASE="${BASH_REMATCH[1]}"
            LM_BASE="${LM_BASE%%[[:space:]]}"
            local feats="${BASH_REMATCH[2]}"
            feats="${feats%"${feats##*[![:space:]]}"}"
            read -ra LM_FEATURES <<< "$feats"
            [[ -n "$LM_BASE" ]] && return 0
        fi
    fi
    
    return 1
}

# Core merge logic
do_merge() {
    local name=$1
    local base=$2
    shift 2
    local features=("$@")
    
    local target_branch="${LM_NAME_TEMPLATE//\{name\}/$name}"
    
    if [[ -n "$(git status --porcelain)" ]]; then
        log_err "Error: Working tree is not clean."
        exit 1
    fi

    # Pre-flight check and cache resolved feature refs for this merge run.
    LM_RESOLVED_REFS=()
    for f in "${features[@]}"; do
        local resolved_ref
        if ! resolved_ref=$(resolve_ref "$f"); then
            log_err "Error: Could not resolve $f. Aborting."
            exit 1
        fi
        require_remote_backed_feature "$f" "$resolved_ref" || exit 1
        if [[ "$resolved_ref" != "FETCH_HEAD" ]]; then
            LM_RESOLVED_REFS["$f"]="$resolved_ref"
        fi
    done

    local base_ref
    base_ref=$(resolve_ref "$base") || { log_err "Error: Base $base not found"; exit 1; }
    
    git checkout -q -B "$target_branch" "$base_ref"
    
    LM_FEATURES=("${features[@]}")
    run_merge_loop "$target_branch" "$base" "${features[@]}"
}

run_merge_loop() {
    local target_branch=$1
    local base=$2
    shift 2
    local queue=("$@")
    local total=${#queue[@]}
    local i=0

    for feature in "${queue[@]}"; do
        i=$((i + 1))
        log_info "[$i/$total] -> Merging: $feature..."
        
        local ref
        ref="${LM_RESOLVED_REFS[$feature]:-}"
        if [[ -z "$ref" ]]; then
            ref=$(resolve_ref "$feature") || { log_err "Error: Could not resolve $feature. Aborting."; exit 1; }
        fi
        require_remote_backed_feature "$feature" "$ref" || exit 1
        
        if ! git merge -q --no-ff --no-commit "$ref" -m "Temp merge $feature" >/dev/null 2>&1; then
            log_err "!!! Conflict detected in $feature !!!"
            local remaining=("${queue[@]:$((i-1))}")
            local feat_content=$(printf "%s\n" "${LM_FEATURES[@]}")
            local pend_content=$(printf "%s\n" "${remaining[@]}")
            save_pending_state "$target_branch" "$base" "$feat_content" "$pend_content"
            log_warn "Manual steps:"
            log_info "  1. Resolve conflicts"
            log_info "  2. git add . && git commit"
            log_info "  3. git lm continue"
            exit 1
        fi
        
        if ! git diff --cached --quiet; then
            git commit -q --no-edit >/dev/null 2>&1
        fi
    done

    # Finalize
    log_info "Finalizing squash merge..."
    git reset -q --soft "$(resolve_ref "$base")" >/dev/null 2>&1
    
    # Write state as machine-readable single-line in commit message
    echo "LM-State: $base;${LM_FEATURES[*]}" | git commit -q --allow-empty -F - >/dev/null 2>&1
    
    # Clear any in-progress pending state (merge completed successfully)
    clear_pending_state "$target_branch"

    print_merge_success_summary "$target_branch" "$base" "${LM_FEATURES[*]}"
}

continue_cmd() {
    local target_branch=$(get_current_branch)
    if [[ -z "$target_branch" || "$target_branch" != "$LM_PREFIX"* ]]; then
        log_err "Error: Not on a LM branch"
        exit 1
    fi
    # continue only applies when there is in-progress pending state
    load_pending_state "$target_branch" || { log_err "Error: No in-progress merge state found for '$target_branch'."; exit 1; }
    
    if [[ ${#LM_PENDING[@]} -eq 0 ]]; then
        log_info "Nothing to continue."
        clear_pending_state "$target_branch"
        exit 0
    fi

    if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
        log_err "Error: Merge in progress. Please resolve conflicts and commit first."
        exit 1
    fi

    log_info "Resuming merge loop for: ${LM_PENDING[*]}"
    run_merge_loop "$target_branch" "$LM_BASE" "${LM_PENDING[@]}"
}

status_cmd() {
    find_target_lm "${1:-}" || return 1
    local full_name="$LM_RESOLVED_BRANCH"
    local name=$(get_lm_task_name "$full_name")

    local local_ref="refs/heads/$full_name"
    local remote_ref="refs/remotes/origin/$full_name"

    local has_local=0
    local has_remote=0
    local local_sha=""
    local remote_sha=""
    local local_info=""
    local remote_info=""
    local local_time="0"
    local remote_time="0"
    local local_base=""
    local remote_base=""
    local local_features=""
    local remote_features=""

    local refs
    refs=$(git for-each-ref --format='%(refname)|%(objectname)|%(authorname)|%(authordate:relative)|%(authordate:unix)|%(contents:subject)' "$local_ref" "$remote_ref" 2>/dev/null || true)
    local ref sha author rel_time unix_time subject
    while IFS='|' read -r ref sha author rel_time unix_time subject; do
        [[ -z "$ref" ]] && continue
        local state_base=""
        local state_features=""
        parse_lm_state_subject "$subject" state_base state_features || true

        if [[ "$ref" == "$local_ref" ]]; then
            has_local=1
            local_sha="$sha"
            local_time="${unix_time:-0}"
            [[ -n "$author" || -n "$rel_time" ]] && local_info="$rel_time by $author"
            local_base="$state_base"
            local_features="$state_features"
        elif [[ "$ref" == "$remote_ref" ]]; then
            has_remote=1
            remote_sha="$sha"
            remote_time="${unix_time:-0}"
            [[ -n "$author" || -n "$rel_time" ]] && remote_info="$rel_time by $author"
            remote_base="$state_base"
            remote_features="$state_features"
        fi
    done <<< "$refs"

    load_origin_ref_cache

    if [[ $has_local -eq 1 ]]; then
        if load_pending_state "$full_name"; then
            local_base="$LM_BASE"
            local_features="${LM_FEATURES[*]}"
            [[ -n "$local_info" ]] || local_info=$(get_commit_info_str "$local_ref")
        fi
        if [[ -n "$local_base" ]]; then
            printf "Branch  : \e[1;33m%s\e[0m\n" "$full_name"
            printf "Base    : \e[1;36m%s\e[0m\n" "$local_base"
            print_features_line "$local_features"
            [[ ${#LM_PENDING[@]} -gt 0 ]] && log_warn "Pending : ${LM_PENDING[*]}"
            [[ -n "$local_info" ]] && printf "Commit  : Local [\e[90m%s\e[0m]\n" "$local_info"
            if [[ $has_remote -eq 0 ]]; then
                warn_missing_origin_feature_sets "" "$local_features"
            fi
        else
            log_err "Error: No local state found for $full_name"
        fi
    elif [[ $has_remote -eq 1 ]]; then
        if [[ -n "$remote_base" ]]; then
            printf "Branch  : \e[1;34morigin/%s\e[0m (remote-only)\n" "$name"
            printf "Base    : \e[1;36m%s\e[0m\n" "$remote_base"
            print_features_line "$remote_features"
            [[ -n "$remote_info" ]] && printf "Commit  : Remote [\e[90m%s\e[0m]\n" "$remote_info"
            warn_missing_origin_feature_sets "" "$remote_features"
        else
            log_err "Error: No remote state found for $full_name"
        fi
    else
        log_err "Error: No task branch found for $full_name"
        return 1
    fi

    # Print sync status
    if [[ $has_local -eq 1 && $has_remote -eq 1 ]]; then
        if [[ "$local_sha" == "$remote_sha" ]]; then
            printf "Sync    : \e[1;32mUp-to-date with origin\e[0m\n"
            warn_missing_origin_feature_sets "" "$local_features" "$remote_features"
        else
            log_warn "Sync    : Inconsistent with remote!"

            local local_difference_features=""
            local remote_difference_features=""
            get_feature_difference "$local_features" "$remote_features" local_difference_features
            get_feature_difference "$remote_features" "$local_features" remote_difference_features
            format_state_line "          " "local" "$local_info" "$local_base" "$local_features" "$local_difference_features"
            format_state_line "          " "remote" "$remote_info" "$remote_base" "$remote_features" "$remote_difference_features"
            warn_missing_origin_feature_sets "          " "$local_features" "$remote_features"

            if [[ "$local_time" -gt "$remote_time" ]]; then
                log_info "          (Local is newer. Run 'git lm push' to push or 'git lm sync' to sync)"
            else
                log_info "          (Remote is newer. Run 'git lm pull' to pull or 'git lm sync' to sync)"
            fi
        fi
    elif [[ $has_remote -eq 1 ]]; then
        log_info "Sync    : Remote-only (run 'git lm pull' to checkout)"
    else
        log_info "Sync    : Local-only (run 'git lm push' to share)"
    fi
}

abort_cmd() {
    local delete_remote=0
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r) delete_remote=1; shift ;;
            *)  args+=("$1"); shift ;;
        esac
    done

    find_target_lm "${args[0]:-}" || return 1
    local target_branch="$LM_RESOLVED_BRANCH"
    
    # Load state to get base branch for checkout
    if load_state "$target_branch"; then
        local base="$LM_BASE"
    else
        # No state — just try to checkout a sensible branch
        local base
        base=$(get_default_base_branch)
    fi
    
    # If currently on this branch, switch away first
    local current=$(get_current_branch)
    if [[ "$current" == "$target_branch" ]]; then
        git checkout -q "$base" 2>/dev/null || git checkout -q main 2>/dev/null || git checkout -q master 2>/dev/null || true
    fi
    
    # Delete local branch if it exists
    if git show-ref --verify -q "refs/heads/$target_branch" 2>/dev/null; then
        git branch -D "$target_branch"
        log_info "Deleted local branch '$target_branch'."
    fi
    
    # Clear in-progress pending state
    clear_pending_state "$target_branch"
    
    # Optionally delete remote branch
    if [[ $delete_remote -eq 1 ]]; then
        if git push origin --delete "$target_branch" 2>/dev/null; then
            log_info "Deleted remote branch 'origin/$target_branch'."
        else
            log_warn "Could not delete remote branch 'origin/$target_branch' (may not exist)."
        fi
    fi
    
    log_info "Aborted: $target_branch"
}

prune_cmd() {
    log_info "Pruning orphaned in-progress conflict files..."
    local count=0
    if [[ -d "$LM_PENDING_ROOT" ]]; then
        for d in "$LM_PENDING_ROOT"/*; do
            [[ -d "$d" ]] || continue
            local safe_name=$(basename "$d")
            # Check if any local branch still corresponds to this pending dir
            local found=0
            local branches=($(git branch --list "${LM_PREFIX}*" --format='%(refname:short)'))
            for b in "${branches[@]}"; do
                local s="${b//[\/\\ :*?\"<>|]/__}"
                if [[ "$s" == "$safe_name" ]]; then
                    found=1; break
                fi
            done
            if [[ $found -eq 0 ]]; then
                rm -rf "$d"
                count=$((count + 1))
            fi
        done
        find "$LM_PENDING_ROOT" -type d -empty -delete 2>/dev/null || true
    fi
    log_info "Cleaned up $count orphaned conflict state(s)."
}

push_cmd() {
    local name="${1:-}"
    find_target_lm "$name" || return 1
    local full_name="$LM_RESOLVED_BRANCH"
    
    # Verify local branch exists
    if ! git show-ref --verify -q "refs/heads/$full_name" 2>/dev/null; then
        log_err "Error: Local branch '$full_name' does not exist."
        return 1
    fi

    guard_lm_state_has_no_missing_origin_features "$full_name" "local" "push" || return 1
    
    # Check if remote branch exists. If so, delete it first.
    local remote_ref="refs/remotes/origin/$full_name"
    if git show-ref --verify -q "$remote_ref" 2>/dev/null; then
        log_info "Deleting remote branch '$full_name' on origin first..."
        git push origin --delete "$full_name" || true
    fi
    
    log_info "Pushing local branch '$full_name' to origin..."
    git push origin "$full_name:$full_name"
    git fetch -q origin "$full_name:refs/remotes/origin/$full_name" >/dev/null 2>&1 || true
    print_lm_task_summary_block "Summary" "$full_name"
}

pull_cmd() {
    local name="${1:-}"
    find_target_lm "$name" || return 1
    local full_name="$LM_RESOLVED_BRANCH"
    
    local remote_ref="refs/remotes/origin/$full_name"
    if ! git show-ref --verify -q "$remote_ref" 2>/dev/null; then
        log_err "Error: Remote branch 'origin/$full_name' does not exist."
        return 1
    fi

    guard_lm_state_has_no_missing_origin_features "$full_name" "remote" "pull" || return 1
    
    local local_ref="refs/heads/$full_name"
    if ! git show-ref --verify -q "$local_ref" 2>/dev/null; then
        log_info "Creating local branch '$full_name' from remote 'origin/$full_name'..."
        git checkout -b "$full_name" --track "origin/$full_name"
    else
        log_info "Overriding local branch '$full_name' with remote 'origin/$full_name'..."
        local current=$(get_current_branch)
        if [[ "$current" == "$full_name" ]]; then
            git reset --hard "origin/$full_name"
        else
            git branch -f "$full_name" "origin/$full_name"
        fi
    fi

    print_lm_task_summary_block "Summary" "$full_name"
}

sync_cmd() {
    local name="${1:-}"
    find_target_lm "$name" || return 1
    local full_name="$LM_RESOLVED_BRANCH"
    
    local local_ref="refs/heads/$full_name"
    local remote_ref="refs/remotes/origin/$full_name"
    
    local has_local=0
    local has_remote=0
    local local_sha=""
    local remote_sha=""
    local local_time="0"
    local remote_time="0"

    local refs
    refs=$(git for-each-ref --format='%(refname)|%(objectname)|%(authordate:unix)' "$local_ref" "$remote_ref" 2>/dev/null || true)
    local ref sha unix_time
    while IFS='|' read -r ref sha unix_time; do
        [[ -z "$ref" ]] && continue
        if [[ "$ref" == "$local_ref" ]]; then
            has_local=1
            local_sha="$sha"
            local_time="${unix_time:-0}"
        elif [[ "$ref" == "$remote_ref" ]]; then
            has_remote=1
            remote_sha="$sha"
            remote_time="${unix_time:-0}"
        fi
    done <<< "$refs"
    
    if [[ $has_local -eq 0 && $has_remote -eq 0 ]]; then
        log_err "Error: light-merge task '$full_name' not found locally or remotely."
        return 1
    fi
    
    if [[ $has_local -eq 1 && $has_remote -eq 0 ]]; then
        log_info "Task '$full_name' is local-only. Pushing to origin..."
        push_cmd "$full_name"
        return 0
    fi
    
    if [[ $has_local -eq 0 && $has_remote -eq 1 ]]; then
        log_info "Task '$full_name' is remote-only. Pulling from origin..."
        pull_cmd "$full_name"
        return 0
    fi
    
    # Both exist. Exact same commit means already synced; otherwise newest LM-generated commit wins.
    if [[ "$local_sha" == "$remote_sha" ]]; then
        log_info "Task '$full_name' is already in sync with remote."
        if ! guard_lm_state_has_no_missing_origin_features "$full_name" "local" "sync"; then
            return 1
        fi
        if ! guard_lm_state_has_no_missing_origin_features "$full_name" "remote" "sync"; then
            return 1
        fi
        print_lm_task_summary_block "Summary" "$full_name"
        return 0
    fi

    if [[ "$local_time" -gt "$remote_time" ]]; then
        log_info "Local task '$full_name' is newer ($local_time > $remote_time). Pushing to remote..."
        push_cmd "$full_name"
    elif [[ "$remote_time" -gt "$local_time" ]]; then
        log_info "Remote task '$full_name' is newer ($remote_time > $local_time). Pulling to local..."
        pull_cmd "$full_name"
    else
        log_warn "Task '$full_name' differs from remote, but both commits have the same timestamp."
        log_warn "Refusing to guess. Run 'git lm push' or 'git lm pull' to choose which side wins."
        return 1
    fi
}

pick_cmd() {
    local base="$1"; shift
    local name=""
    if [[ $# -lt 1 ]]; then
        if ! find_target_lm ""; then
            exit 1
        fi
        local resolved_branch="$LM_RESOLVED_BRANCH"
        
        # Extract the clean name from the resolved full branch name
        name=$(get_lm_task_name "$resolved_branch")
    else
        name=$1
    fi
    
    local selected_features=()
    local existing_features=()
    local existing_base=""
    local LM_FEATURES=()

    local full_name
    resolve_lm_branch full_name "$name"
    local existing_features_str=""
    if get_pending_state_values "$full_name" existing_base existing_features_str; then
        read -ra existing_features <<< "$existing_features_str"
    else
        local state_refs
        state_refs=$(git for-each-ref --format='%(refname)|%(contents:subject)' "refs/heads/$full_name" "refs/remotes/origin/$full_name" 2>/dev/null || true)
        local local_subject=""
        local remote_subject=""
        local state_ref subject
        while IFS='|' read -r state_ref subject; do
            [[ -z "$state_ref" ]] && continue
            if [[ "$state_ref" == "refs/heads/$full_name" ]]; then
                local_subject="$subject"
            elif [[ "$state_ref" == "refs/remotes/origin/$full_name" ]]; then
                remote_subject="$subject"
            fi
        done <<< "$state_refs"

        if parse_lm_state_subject "${local_subject:-$remote_subject}" existing_base existing_features_str; then
            read -ra existing_features <<< "$existing_features_str"
        fi
    fi

    # Resolve base branch first
    if [[ -z "$base" ]]; then
        # Try to load existing state to reuse the base branch
        if [[ -n "$existing_base" ]]; then
            base="$existing_base"
            log_info "Reusing existing base: $base"
        else
            # Auto-detect default base branch from remote HEAD
            base=$(get_default_base_branch)
        fi
    fi

    # Collect branches by recency, with local/remote categorization and base excluded.
    # Existing features are promoted to the front afterwards, preserving merge order.
    declare -A pick_seen=()
    declare -A pick_is_local=()
    declare -A pick_is_remote=()
    declare -A pick_ordered=()
    local pick_order=()
    local recent_pick_order=()
    local branch_refs
    branch_refs=$(git for-each-ref --sort=-committerdate --format='%(refname)|%(refname:short)' refs/heads refs/remotes/origin 2>/dev/null || true)
    local ref short branch
    while IFS='|' read -r ref short; do
        [[ -z "$ref" ]] && continue
        if [[ "$ref" == refs/heads/* ]]; then
            branch="$short"
            pick_is_local["$branch"]=1
        elif [[ "$ref" == refs/remotes/origin/* ]]; then
            [[ "$ref" == refs/remotes/origin/HEAD ]] && continue
            branch="${short#origin/}"
            pick_is_remote["$branch"]=1
        else
            continue
        fi

        [[ -z "$branch" || "$branch" == "$base" || "$branch" == "$LM_PREFIX"* ]] && continue
        if [[ -z "${pick_seen[$branch]:-}" ]]; then
            pick_seen["$branch"]=1
            recent_pick_order+=("$branch")
        fi
    done <<< "$branch_refs"

    # Keep current features at the top in their saved merge order. All remaining
    # branches retain the recency order supplied by git for-each-ref above.
    for branch in "${existing_features[@]}"; do
        if [[ -n "${pick_seen[$branch]:-}" && -z "${pick_ordered[$branch]:-}" ]]; then
            pick_order+=("$branch")
            pick_ordered["$branch"]=1
        fi
    done
    for branch in "${recent_pick_order[@]}"; do
        if [[ -z "${pick_ordered[$branch]:-}" ]]; then
            pick_order+=("$branch")
            pick_ordered["$branch"]=1
        fi
    done

    local branch_list=""
    for branch in "${pick_order[@]}"; do
        if [[ -n "${pick_is_local[$branch]:-}" && -n "${pick_is_remote[$branch]:-}" ]]; then
            branch_list+="$branch [local & remote]"$'\n'
        elif [[ -n "${pick_is_local[$branch]:-}" ]]; then
            branch_list+="$branch [local only]"$'\n'
        elif [[ -n "${pick_is_remote[$branch]:-}" ]]; then
            branch_list+="$branch [remote only]"$'\n'
        fi
    done

    if [[ "$branch_list" == *"[local only]"* ]]; then
        log_warn "Local-only branches are shown for visibility but cannot be selected. Push them to origin first."
    fi

    ensure_picker_plugin
    if [[ -x "$GIT_LM_PICKER_PLUGIN" ]]; then
        log_info "Using interactive Bash picker plugin..."
        local selected
        local selected_input=""
        if [[ ${#existing_features[@]} -gt 0 ]]; then
            # Join array elements by comma safely under set -u
            selected_input=$(IFS=,; echo "${existing_features[*]}")
        fi
        if ! selected=$(echo "$branch_list" | "$GIT_LM_PICKER_PLUGIN" --header "Base: $base | Space/Tab select | [ / ] change merge order | Enter confirm" --selected "$selected_input"); then
            log_warn "Aborted."
            exit 0
        fi
        
        while read -r line; do
            if [[ -n "$line" ]]; then
                selected_features+=("${line%% *}")
            fi
        done <<< "$selected"
    else
        log_info "Using native numbered list picker..."
        local annotated_branches=()
        while read -r line; do
            [[ -n "$line" ]] && annotated_branches+=("$line")
        done <<< "$branch_list"

        local limit=30
        local total=${#annotated_branches[@]}
        local count=$total
        if [[ $count -gt $limit ]]; then
            count=$limit
        fi

        log_info "Base branch: $base"
        for ((i=0; i<count; i++)); do
            local branch_name="${annotated_branches[$i]%% *}"
            local checkbox="[ ]"
            local merge_order=0
            for f in "${existing_features[@]}"; do
                if [[ "$f" == "$branch_name" ]]; then
                    checkbox="[$((merge_order + 1))]"
                    break
                fi
                merge_order=$((merge_order + 1))
            done
            printf "  [%2d] %s %s\n" "$((i+1))" "$checkbox" "${annotated_branches[$i]}"
        done

        if [[ $total -gt $limit ]]; then
            log_warn "  ... showing first $limit of $total branches (sorted by recency)."
            log_info "  Tip: Configure 'git-lm-picker' plugin for a fully searchable interactive picker."
        fi

        if [[ ${#existing_features[@]} -gt 0 ]]; then
            printf "\nEnter branch numbers in merge order (Enter keeps the numbered order, e.g., 2 1 3), or 'q' to quit: "
        else
            printf "\nEnter branch numbers in merge order (e.g., 1 3 5), or 'q' to quit: "
        fi
        read -r input
        if [[ "$input" == "q" ]]; then exit 0; fi
        if [[ -z "$input" && ${#existing_features[@]} -gt 0 ]]; then
            selected_features=("${existing_features[@]}")
        else
            for idx in $input; do
                if [[ "$idx" -gt 0 && "$idx" -le "$count" ]]; then
                    local selected_annotated="${annotated_branches[$((idx-1))]}"
                    selected_features+=("${selected_annotated%% *}")
                fi
            done
        fi
    fi

    if [[ ${#selected_features[@]} -eq 0 ]]; then
        log_warn "No features selected. Aborting."
        exit 0
    fi

    log_info "Selected features: ${selected_features[*]}"
    do_merge "$name" "$base" "${selected_features[@]}"
}

refresh_cmd() {
    local base=""
    local args=()
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "--base" ]]; then
            if [[ $# -lt 2 ]]; then
                log_err "Error: --base requires a branch name."
                return 1
            fi
            base="$2"; shift 2
        else
            args+=("$1"); shift
        fi
    done

    find_target_lm "${args[0]:-}" || return 1
    local full_name="$LM_RESOLVED_BRANCH"
    load_state "$full_name" || { log_err "Error: No state found for $full_name"; exit 1; }
    
    if [[ -n "$base" ]]; then
        LM_BASE="$base"
    fi
    
    local has_origin=0
    if git config --get remote.origin.url >/dev/null 2>&1; then
        has_origin=1
        log_info "Refreshing base and features for $full_name from origin..."
        # Update base (local branch)
        if ! git fetch origin "$LM_BASE:$LM_BASE" 2>/dev/null; then
            log_warn "Could not fetch base '$LM_BASE' from origin. Using local ref if available."
        fi
    else
        log_warn "No remote 'origin' found. Using local branches only."
    fi
    
    # Update features in a single batch fetch for performance
    local fetch_args=()
    for f in "${LM_FEATURES[@]}"; do
        if [[ $has_origin -eq 1 ]]; then
            fetch_args+=("$f:$f")
        fi
    done
    
    if [[ ${#fetch_args[@]} -gt 0 ]]; then
        log_info "Batch fetching features from origin..."
        if ! git fetch origin "${fetch_args[@]}" 2>/dev/null; then
            log_warn "Could not batch fetch feature branches from origin. Using local refs if available."
        fi
    fi
    
    local name=$(get_lm_task_name "$full_name")
    do_merge "$name" "$LM_BASE" "${LM_FEATURES[@]}"
}

clear_cmd() {
    local branches=$(git branch --list "${LM_PREFIX}*" --format='%(refname:short)')
    if [[ -z "$branches" ]]; then
        log_info "No local light-merge branches found."
        return
    fi

    log_warn "This will delete ALL local branches starting with '$LM_PREFIX'. Remote branches are NOT affected."
    printf "Are you sure? [y/N] "
    read -r opt
    if [[ "$opt" != "y" && "$opt" != "Y" ]]; then
        log_info "Aborted."
        return
    fi
    
    local current=$(get_current_branch)
    if [[ "$current" == "$LM_PREFIX"* ]]; then
        local default
        default=$(get_default_base_branch)
        log_info "Switching to $default..."
        git checkout -q "$default" 2>/dev/null || git checkout -q main 2>/dev/null || git checkout -q master 2>/dev/null
    fi
    echo "$branches" | xargs git branch -D
    rm -rf "$LM_PENDING_ROOT"
    log_info "All local light-merge branches cleared."
}

create_cmd() {
    local base=""
    local args=()
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "--base" ]]; then
            if [[ $# -lt 2 ]]; then
                log_err "Error: --base requires a branch name."
                return 1
            fi
            base="$2"; shift 2
        else
            args+=("$1"); shift
        fi
    done

    if [[ ${#args[@]} -lt 1 ]]; then show_help; exit 1; fi
    local name="${args[0]}"
    local features=()
    if [[ ${#args[@]} -gt 1 ]]; then
        for ((i=1; i<${#args[@]}; i++)); do
            features+=("${args[$i]}")
        done
    fi

    if [[ -z "$base" ]]; then
        # Try to load existing state to reuse the base branch
        local full_name
        resolve_lm_branch full_name "$name"
        if load_state "$full_name" >/dev/null 2>&1; then
            base="$LM_BASE"
            log_info "Reusing existing base: $base"
        else
            # Auto-detect default base branch from remote HEAD
            base=$(get_default_base_branch)
        fi
    fi
    
    if [[ ${#features[@]} -eq 0 && "$name" != "--help" && "$name" != "-h" ]]; then
        # If only name is provided, it might be an attempt to use 'git lm <name>' 
        # but the user didn't provide features. However, do_merge requires features.
        show_help
        exit 1
    fi

    do_merge "$name" "$base" "${features[@]}"
}

get_commit_info_str() {
    local ref="$1"
    local info
    info=$(git log -1 --format="%an|%ar" "$ref" 2>/dev/null || true)
    if [[ -n "$info" ]]; then
        local author="${info%%|*}"
        local rel_time="${info#*|}"
        echo "$rel_time by $author"
    else
        echo ""
    fi
}

list_cmd() {
    # Read all local and remote branches in refs/heads/light-merge/ and refs/remotes/origin/light-merge/
    declare -A local_tasks
    declare -A remote_tasks
    LM_LIST_SHA_CACHE=()
    LM_LIST_INFO_CACHE=()
    LM_LIST_BASE_CACHE=()
    LM_LIST_FEATURES_CACHE=()
    LM_LIST_ORIGIN_REF_CACHE=()
    
    local refs
    refs=$(git for-each-ref --format='%(refname)|%(objectname)|%(authorname)|%(authordate:relative)|%(contents:subject)' "refs/heads/${LM_PREFIX}*" "refs/remotes/origin/${LM_PREFIX}*" 2>/dev/null || true)
    
    if [[ -z "$refs" ]]; then
        log_info "No light-merge branches found."
        return
    fi

    local origin_refs
    origin_refs=$(git for-each-ref --format='%(refname)' refs/remotes/origin 2>/dev/null || true)
    local origin_ref
    while IFS= read -r origin_ref; do
        [[ -n "$origin_ref" ]] && LM_LIST_ORIGIN_REF_CACHE["$origin_ref"]=1
    done <<< "$origin_refs"

    while IFS='|' read -r ref sha author rel_time subject; do
        [[ -z "$ref" ]] && continue
        LM_LIST_SHA_CACHE["$ref"]="$sha"
        if [[ -n "$author" || -n "$rel_time" ]]; then
            LM_LIST_INFO_CACHE["$ref"]="$rel_time by $author"
        fi
        local state_base=""
        local state_features=""
        if parse_lm_state_subject "$subject" state_base state_features; then
            LM_LIST_BASE_CACHE["$ref"]="$state_base"
            LM_LIST_FEATURES_CACHE["$ref"]="$state_features"
        fi
        if [[ "$ref" == refs/heads/* ]]; then
            local branch="${ref#refs/heads/}"
            local task=$(get_lm_task_name "$branch")
            local_tasks["$task"]="$branch"
        elif [[ "$ref" == refs/remotes/origin/* ]]; then
            local branch="${ref#refs/remotes/origin/}"
            local task=$(get_lm_task_name "$branch")
            remote_tasks["$task"]="$branch"
        fi
    done <<< "$refs"

    # Get union of keys
    local all_tasks=()
    for t in "${!local_tasks[@]}"; do
        all_tasks+=("$t")
    done
    for t in "${!remote_tasks[@]}"; do
        if [[ -z "${local_tasks[$t]:-}" ]]; then
            all_tasks+=("$t")
        fi
    done
    
    # Sort tasks alphabetically
    local sorted_tasks=()
    if [[ ${#all_tasks[@]} -gt 0 ]]; then
        IFS=$'\n' sorted_tasks=($(sort <<< "${all_tasks[*]}")); unset IFS
    fi

    log_info "Available light-merge branches:"
    local current=$(get_current_branch)
    
    for t in "${sorted_tasks[@]}"; do
        local local_branch="${local_tasks[$t]:-}"
        local remote_branch="${remote_tasks[$t]:-}"
        
        local task_type=""
        local prefix="  "
        local is_current=0
        
        if [[ -n "$local_branch" && -n "$remote_branch" ]]; then
            task_type="L+R"
            if [[ "$local_branch" == "$current" ]]; then
                prefix="* "
                is_current=1
            fi
        elif [[ -n "$local_branch" ]]; then
            task_type="L"
            if [[ "$local_branch" == "$current" ]]; then
                prefix="* "
                is_current=1
            fi
        else
            task_type="R"
        fi
        
        local type_color=""
        if [[ "$task_type" == "L+R" ]]; then
            type_color="\e[1;32m" # Green
        elif [[ "$task_type" == "L" ]]; then
            type_color="\e[1;36m" # Cyan
        else
            type_color="\e[1;34m" # Blue
        fi
        
        local task_name="${LM_PREFIX}${t}"
        local task_header
        if [[ $is_current -eq 1 ]]; then
            task_header="\e[1;32m${task_name}\e[0m (${type_color}${task_type}\e[0m)"
        else
            task_header="\e[1;33m${task_name}\e[0m (${type_color}${task_type}\e[0m)"
        fi
        local summary_leading="${prefix} ${task_header} "

        print_lm_task_summary_lines "    " "$task_name" "$summary_leading"
    done
}

add_cmd() {
    local feature="${1:-}"
    local target_task="${2:-}"
    
    # 1. Resolve feature: default to current branch if not provided or if '.' is used
    if [[ -z "$feature" || "$feature" == "." ]]; then
        feature=$(get_current_branch)
        if [[ -z "$feature" ]]; then log_err "Error: Not on a branch."; return 1; fi
        if [[ "$feature" == "$LM_PREFIX"* ]]; then
            log_err "Error: Cannot add a light-merge branch to itself."
            return 1
        fi
    fi
    
    # 2. Resolve target task
    find_target_lm "$target_task" || return 1
    local full_name="$LM_RESOLVED_BRANCH"
    
    # 3. Load state and check if already exists
    load_state "$full_name" || { log_err "Error: No state found for $full_name"; return 1; }

    if [[ "$feature" == "$LM_BASE" ]]; then
        log_err "Error: '$feature' is the base branch of $full_name. Cannot add base as a feature."
        return 1
    fi

    for f in "${LM_FEATURES[@]}"; do
        if [[ "$f" == "$feature" ]]; then
            log_info "Feature $feature is already in $full_name. Refreshing..."
            local name=$(get_lm_task_name "$full_name")
            do_merge "$name" "$LM_BASE" "${LM_FEATURES[@]}"
            return
        fi
    done
    
    # 4. Add and rebuild
    LM_FEATURES+=("$feature")
    local name=$(get_lm_task_name "$full_name")
    log_info "Adding $feature to $full_name..."
    do_merge "$name" "$LM_BASE" "${LM_FEATURES[@]}"
}

rm_cmd() {
    local feature="${1:-}"
    local target_task="${2:-}"
    
    # 1. Resolve feature: default to current branch if not provided or if '.' is used
    if [[ -z "$feature" || "$feature" == "." ]]; then
        feature=$(get_current_branch)
    fi
    
    # 2. Resolve target task
    find_target_lm "$target_task" || return 1
    local full_name="$LM_RESOLVED_BRANCH"
    
    # 3. Load state and filter
    load_state "$full_name" || { log_err "Error: No state found for $full_name"; return 1; }

    if [[ "$feature" == "$LM_BASE" ]]; then
        log_err "Error: '$feature' is the base branch of $full_name. To change the base, use 'git lm refresh --base <new_base>'."
        return 1
    fi

    local new_features=()
    local found=0
    for f in "${LM_FEATURES[@]}"; do
        if [[ "$f" == "$feature" ]]; then
            found=1
        else
            new_features+=("$f")
        fi
    done
    
    if [[ $found -eq 0 ]]; then
        log_warn "Feature $feature not found in $full_name."
        return
    fi
    
    # 4. Rebuild
    local name=$(get_lm_task_name "$full_name")
    log_info "Removing $feature from $full_name..."
    do_merge "$name" "$LM_BASE" "${new_features[@]}"
}

main() {
    ensure_git_repo
    [[ $# -eq 0 ]] && { show_help; exit 0; }

    case "$1" in
        create|new|mk) shift; create_cmd "$@" ;;
        add) shift; add_cmd "$@" ;;
        rm)  shift; rm_cmd "$@" ;;
        status|st) shift; status_cmd "$@" ;;
        list|ls) list_cmd ;;
        abort) shift; abort_cmd "$@" ;;
        continue|con) continue_cmd ;;
        push) shift; push_cmd "$@" ;;
        pull) shift; pull_cmd "$@" ;;
        sync) shift; sync_cmd "$@" ;;
        refresh|rebase|rf) shift; refresh_cmd "$@" ;;
        clear)   clear_cmd ;;
        pick)
            shift
            local base=""
            local args=()
            while [[ $# -gt 0 ]]; do
                if [[ "$1" == "--base" ]]; then
                    if [[ $# -lt 2 ]]; then
                        log_err "Error: --base requires a branch name."
                        return 1
                    fi
                    base="$2"; shift 2
                else
                    args+=("$1"); shift
                fi
            done
            pick_cmd "$base" "${args[@]}"
            ;;
        prune) prune_cmd ;;
        help|--help|-h) show_help ;;
        *) create_cmd "$@" ;;
    esac
}

main "$@"
